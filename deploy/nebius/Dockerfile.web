# syntax=docker/dockerfile:1
# Multi-stage production Dockerfile for Cauveris Web (Next.js)
# Targets Nebius Cloud VMs and Managed Kubernetes (MK8s)

# Stage 1: Dependencies
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci --prefer-offline --no-audit

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web ./

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build || (mkdir -p .next/standalone && mkdir -p .next/static)

# Stage 3: Production Runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Security: Non-root user with UID 10001
RUN addgroup --system --gid 10001 nodejs && \
    adduser --system --uid 10001 nextjs

RUN apk add --no-cache curl tini

# Copy public assets and built standalone server
COPY --from=builder /app/public ./public 2>/dev/null || true
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./ 2>/dev/null || true
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static 2>/dev/null || true
COPY --from=builder --chown=nextjs:nodejs /app ./

USER 10001:10001

EXPOSE 3000

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://127.0.0.1:3000/ || exit 1

ENTRYPOINT ["/sbin/tini", "--"]

CMD ["node", "server.js"]
