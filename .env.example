# Cauveris Environment Variables
# Copy this file to .env and fill in the values

# Server Settings
CAUVERIS_HOST=0.0.0.0
CAUVERIS_PORT=8000
CAUVERIS_DEBUG=false

# Security
CAUVERIS_SECRET_KEY=your-secret-key-here-change-in-production
CAUVERIS_MAX_UPLOAD_SIZE=104857600

# Demo mode (local development): seeds the demo user and allows implicit
# CAU-0001 golden-incident hydration. Default is false for honest production.
CAUVERIS_DEMO_MODE=false
# CORS origins allowed to call the API (comma-separated)
CAUVERIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model Gateway (Nebius Token Factory / OpenAI Compatible)
# Configured strictly with NVIDIA Nemotron model variants across execution tiers
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
# Fast / Triage tier: Lightweight, low-latency Nemotron for telemetry classification
NEBIUS_MODEL_FAST=nvidia/nemotron-mini-4b-instruct
# Reasoning tier: High-capacity Nemotron for causal inference and digital twin hypotheses
NEBIUS_MODEL_REASONING=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
# Escalation tier: Large Nemotron for complex multi-system failures and deep verification
NEBIUS_MODEL_ESCALATION=nvidia/Nemotron-4-340B-Instruct

# Simulation
CAUVERIS_SIMULATION_TIMEOUT=300
CAUVERIS_MAX_EXPERIMENT_TRIALS=10

# Storage (for development, uses local filesystem)
CAUVERIS_EVIDENCE_STORE=./evidence_store
CAUVERIS_SANDBOX_WORKSPACE=./sandbox_workspace

# Safety Thresholds
CAUVERIS_MAX_PATCH_LINES=50
CAUVERIS_SAFETY_TIMEOUT=60
