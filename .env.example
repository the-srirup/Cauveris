# Cauveris Environment Variables
# Copy this file to .env and fill in the values

# Server Settings
CAUVERIS_HOST=0.0.0.0
CAUVERIS_PORT=8000
CAUVERIS_DEBUG=false

# Security
CAUVERIS_SECRET_KEY=your-secret-key-here-change-in-production
CAUVERIS_MAX_UPLOAD_SIZE=104857600

# Model Gateway (Nebius Token Factory)
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.nebius.ai/v1
NEBIUS_MODEL_FAST=nemotron-3-nano
NEBIUS_MODEL_REASONING=nemotron-3-super
NEBIUS_MODEL_ESCALATION=nemotron-3-ultra

# Simulation
CAUVERIS_SIMULATION_TIMEOUT=300
CAUVERIS_MAX_EXPERIMENT_TRIALS=10

# Storage (for development, uses local filesystem)
CAUVERIS_EVIDENCE_STORE=./evidence_store
CAUVERIS_SANDBOX_WORKSPACE=./sandbox_workspace

# Safety Thresholds
CAUVERIS_MAX_PATCH_LINES=50
CAUVERIS_SAFETY_TIMEOUT=60