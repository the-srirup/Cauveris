/* ============================================================
   UTILITIES - GITHUB PRIMER PATTERNS
   ============================================================ */

@layer utilities {
  /* Page Layout */
  .page-layout {
    display: grid;
    grid-template-columns: var(--shell-sidebar-width) 1fr var(--shell-inspector-width);
    grid-template-rows: var(--shell-topbar-height) 1fr var(--shell-tray-closed-height);
    grid-template-areas:
      "sidebar topbar inspector"
      "sidebar main inspector"
      "sidebar tray tray";
    min-height: 100vh;
    height: 100vh;
  }

  .page-layout.sidebar-collapsed {
    grid-template-columns: var(--shell-sidebar-collapsed-width) 1fr var(--shell-inspector-width);
  }

  .page-layout.inspector-collapsed {
    grid-template-columns: var(--shell-sidebar-width) 1fr;
    grid-template-areas:
      "sidebar topbar"
      "sidebar main"
      "sidebar tray";
  }

  .page-layout.sidebar-collapsed.inspector-collapsed {
    grid-template-columns: var(--shell-sidebar-collapsed-width) 1fr;
  }

  /* Focus ring utility */
  .focus-ring {
    @apply focus-visible:outline-none;
    box-shadow: var(--shadow-focus);
  }

  /* Text truncation */
  .truncate-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Monospace text */
  .font-mono-xs {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
  }

  .font-mono-sm {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  .font-mono-md {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: var(--text-md-lh);
  }

  /* Button heights */
  .btn-sm {
    height: 24px;
    padding: 0 8px;
    font-size: var(--text-sm);
  }

  .btn-md {
    height: 32px;
    padding: 0 12px;
    font-size: var(--text-sm);
  }

  .btn-lg {
    height: 40px;
    padding: 0 16px;
    font-size: var(--text-md);
  }

  /* Input height */
  .input-height {
    height: 32px;
    padding: var(--input-padding);
  }

  /* Card base */
  .card-base {
    background: var(--color-canvas-inset);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  /* Badge base */
  .badge-base {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px 8px;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--text-xs-lh);
    border-radius: var(--radius-full);
  }

  /* Page Header - Flush with content grid */
  .page-header {
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: transparent;
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-canvas-inset);
  }

  /* Table styles */
  .table-container {
    overflow-x: auto;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .table th {
    text-align: left;
    padding: 10px 14px;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-fg-muted);
    background: var(--color-canvas-inset);
    border-bottom: 1px solid var(--color-border-default);
    white-space: nowrap;
  }

  .table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border-muted);
    color: var(--color-fg-default);
  }

  .table tbody tr:hover td {
    background: var(--color-canvas-subtle);
  }

  .table tbody tr:last-child td {
    border-bottom: none;
  }

  /* Tab navigation */
  .tab-nav {
    display: flex;
    border-bottom: 1px solid var(--color-border-default);
    gap: var(--space-1);
  }

  .tab-nav-item {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-fg-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--duration-fast) var(--easing-standard);
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    cursor: pointer;
  }

  .tab-nav-item:hover {
    color: var(--color-fg-default);
  }

  .tab-nav-item.active {
    color: var(--color-accent-fg);
    border-bottom-color: var(--color-accent-fg);
  }

  /* Dropdown menu */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: var(--z-dropdown);
    min-width: 220px;
    margin-top: 4px;
    padding: 4px;
    background: var(--color-canvas-inset);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: 6px 10px;
    font-size: var(--text-sm);
    color: var(--color-fg-default);
    border-radius: var(--radius-sm);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .dropdown-item:hover {
    background: var(--color-canvas-subtle);
  }

  .dropdown-item.danger {
    color: var(--color-danger-fg);
  }

  .dropdown-item.danger:hover {
    background: var(--color-danger-muted);
  }

  .dropdown-divider {
    height: 1px;
    margin: 4px 8px;
    background: var(--color-border-muted);
  }

  /* Avatar */
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    background: var(--color-accent-muted);
    color: var(--color-accent-fg);
    overflow: hidden;
  }

  .avatar-sm {
    width: 24px;
    height: 24px;
    font-size: var(--text-xs);
  }

  .avatar-lg {
    width: 40px;
    height: 40px;
    font-size: var(--text-md);
  }

  /* Progress bar */
  .progress-bar {
    width: 100%;
    height: 6px;
    background: var(--color-border-muted);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--color-success-emphasis);
    border-radius: var(--radius-full);
    transition: width var(--duration-normal) var(--easing-standard);
  }

  /* Skeleton loader */
  .skeleton {
    background: linear-gradient(
      90deg,
      var(--color-canvas-subtle) 25%,
      var(--color-canvas-muted) 50%,
      var(--color-canvas-subtle) 75%
    );
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
    border-radius: var(--radius-sm);
  }

  @keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-6);
    text-align: center;
    color: var(--color-fg-muted);
  }

  .empty-state-icon {
    width: 64px;
    height: 64px;
    margin-bottom: var(--space-4);
    opacity: 0.5;
  }

  .empty-state-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-fg-default);
    margin-bottom: var(--space-2);
  }

  .empty-state-description {
    font-size: var(--text-sm);
    max-width: 280px;
    margin-bottom: var(--space-4);
  }

  /* Tooltip */
  .tooltip {
    position: absolute;
    z-index: var(--z-tooltip);
    padding: 6px 10px;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-fg-on-emphasis);
    background: var(--color-fg-subtle);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    pointer-events: none;
  }

  .tooltip::after {
    content: "";
    position: absolute;
    width: 0;
    height: 0;
    border: 4px solid transparent;
  }

  .tooltip-top::after {
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    border-top-color: var(--color-fg-subtle);
  }

  .tooltip-bottom::after {
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    border-bottom-color: var(--color-fg-subtle);
  }

  .tooltip-left::after {
    right: -8px;
    top: 50%;
    transform: translateY(-50%);
    border-left-color: var(--color-fg-subtle);
  }

  .tooltip-right::after {
    left: -8px;
    top: 50%;
    transform: translateY(-50%);
    border-right-color: var(--color-fg-subtle);
  }

  /* Modal/Dialog overlay */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(1, 4, 9, 0.8);
    backdrop-filter: blur(2px);
  }

  .modal-dialog {
    position: fixed;
    z-index: var(--z-modal);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 560px;
    width: 90%;
    max-height: 85vh;
    overflow-y: auto;
    background: var(--color-canvas-inset);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border-default);
  }

  .modal-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-fg-default);
  }

  .modal-body {
    padding: var(--space-4) var(--space-6);
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-border-default);
  }

  /* Switch/Toggle */
  .switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 44px;
    height: 24px;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch-track {
    position: absolute;
    inset: 0;
    background: var(--color-border-muted);
    border-radius: var(--radius-full);
    transition: background var(--duration-fast) var(--easing-standard);
  }

  .switch-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: var(--color-fg-default);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--easing-standard);
  }

  .switch input:checked + .switch-track {
    background: var(--color-accent-emphasis);
  }

  .switch input:checked + .switch-track + .switch-thumb {
    transform: translateX(20px);
  }

  .switch input:focus-visible + .switch-track {
    box-shadow: var(--shadow-focus);
  }

  /* Label */
  .label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-fg-default);
    margin-bottom: var(--space-1);
  }

  /* Action List (for dropdowns) */
  .action-list {
    padding: 4px;
  }

  .action-list-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: 6px 10px;
    font-size: var(--text-sm);
    color: var(--color-fg-default);
    border-radius: var(--radius-sm);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .action-list-item:hover {
    background: var(--color-canvas-subtle);
  }

  .action-list-item.danger {
    color: var(--color-danger-fg);
  }

  .action-list-item.danger:hover {
    background: var(--color-danger-muted);
  }

  .action-list-divider {
    height: 1px;
    margin: 4px 8px;
    background: var(--color-border-muted);
