                    <>
                      <Check className="h-3.5 w-3.5 text-[var(--color-success-fg)]" />
                      <span className="text-[var(--color-success-fg)]">Copied!</span>
                    </>
                  ) : (
                    <>
                      <FileText className="h-3.5 w-3.5" />
                      Copy JSON
                    </>
                  )}
                </Button>
              )}
