"use client";

import { tv, type VariantProps } from "tailwind-variants";
import { type ReactNode } from "react";

const progressStyles = tv({
  base: `
    w-full h-1.5 rounded-full bg-[var(--color-surface-2)]
    overflow-hidden
  `,
  variants: {
    size: {
      xs: `h-1`,
      sm: `h-1.5`,
      md: `h-2`,
      lg: `h-3`,
    },
    tone: {
      default: ``,
      primary: ``,
      success: ``,
      danger: ``,
      warning: ``,
      info: ``,
    },
  },
  defaultVariants: {
    size: "md",
    tone: "default",
  },
});

const progressBarStyles = tv({
  base: `
    h-full rounded-full transition-all duration-normal ease-out
    transform-gpu
  `,
  variants: {
    tone: {
      default: `bg-brand-primary`,
      primary: `bg-brand-primary`,
      success: `bg-brand-success`,
      danger: `bg-brand-danger`,
      warning: `bg-brand-warning`,
      info: `bg-brand-info`,
    },
    animated: {
      true: `animate-pulse`,
    },
    striped: {
      true: `bg-gradient-to-r from-current via-transparent to-current bg-[length:20px_100%] animate-[stripe_1s_linear_infinite]`,
    },
  },
  defaultVariants: {
    tone: "default",
    animated: false,
    striped: false,
  },
});

const labelStyles = tv({
  base: `
    flex items-center justify-between text-xs font-medium mb-1.5
  `,
  variants: {
    showValue: {
      true: ``,
      false: ``,
    },
  },
});

export interface ProgressProps extends VariantProps<typeof progressStyles> {
  value: number;
  max?: number;
  min?: number;
  label?: ReactNode;
  valueLabel?: ReactNode;
  showValue?: boolean;
  animated?: boolean;
  striped?: boolean;
  className?: string;
  "aria-label"?: string;
  "aria-valuetext"?: string;
}

export function Progress({
  value,
  max = 100,
  min = 0,
  label,
  valueLabel,
  showValue = true,
  animated,
  striped,
  tone,
  size,
  className,
  "aria-label": ariaLabel,
  "aria-valuetext": ariaValueText,
  ...props
}: ProgressProps) {
  const clampedValue = Math.max(min, Math.min(max, value));
  const percentage = ((clampedValue - min) / (max - min)) * 100;

  const toneColors: Record<string, string> = {
    default: "var(--color-brand-primary)",
    primary: "var(--color-brand-primary)",
    success: "var(--color-brand-success)",
    danger: "var(--color-brand-danger)",
    warning: "var(--color-brand-warning)",
    info: "var(--color-brand-info)",
  };

  return (
    <div className={progressStyles({ tone, size, className })} {...props}>
      {(label || showValue || valueLabel) && (
        <div className={labelStyles({ showValue })}>
          {label && <span className="text-[var(--color-text-secondary)]">{label}</span>}
          {(showValue || valueLabel) && (
            <span className="text-[var(--color-text-primary)] font-mono tabular-nums">
              {valueLabel ?? `${Math.round(percentage)}%`}
            </span>
          )}
        </div>
      )}
      <div
        role="progressbar"
        aria-valuenow={clampedValue}
        aria-valuemin={min}
        aria-valuemax={max}
        aria-label={ariaLabel}
        aria-valuetext={ariaValueText}
        className="relative"
      >
        <div
          className={progressBarStyles({ tone, animated, striped })}
          style={{
            width: `${percentage}%`,
            backgroundColor: toneColors[tone || "primary"],
          }}
        />
      </div>
      <style jsx global>{`
        @keyframes stripe {
          0% { background-position: 0 0; }
          100% { background-position: 20px 0; }
        }
      `}</style>
    </div>
  );
}

Progress.displayName = "Progress";
</file>

<file path="apps/web/components/primitives/Select.tsx">
"use client";

import { forwardRef, type SelectHTMLAttributes, type ReactNode, useId } from "react";
import { tv, type VariantProps } from "tailwind-variants";

const selectStyles = tv({
  base: `
    w-full rounded-lg border border-[var(--color-border)]
    bg-[var(--color-surface)]/80 text-[var(--color-text-primary)]
    appearance-none
    transition-colors duration-150 ease-out
    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:border-transparent
    disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-[var(--color-surface)]/40
    cursor-pointer
  `,
  variants: {
    size: {
      sm: `h-8 px-3 text-xs pr-8`,
      md: `h-9 px-3.5 text-sm pr-9`,
      lg: `h-11 px-4 text-base pr-10`,
    },
    state: {
      default: ``,
      error: `border-[var(--color-brand-danger)] focus-visible:ring-[var(--color-brand-danger)]`,
      success: `border-[var(--color-brand-success)] focus-visible:ring-[var(--color-brand-success)]`,
    },
  },
  defaultVariants: {
    size: "md",
    state: "default",
  },
});

const chevronDown = (
  <svg className="h-4 w-4 text-[var(--color-text-muted)] pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={2}>
    <path d="M6 9l6 6 6-6" />
  </svg>
);

export interface SelectOption {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface SelectProps extends Omit<SelectHTMLAttributes<HTMLSelectElement>, "size">, VariantProps<typeof selectStyles> {
  label?: string;
  hint?: string;
  error?: string;
  options: SelectOption[];
  placeholder?: string;
  leftIcon?: ReactNode;
  onValueChange?: (value: string) => void;
}

// Props that should NOT be forwarded to the native <select> element
const SELECT_PROPS_TO_OMIT: readonly string[] = ['label', 'hint', 'error', 'options', 'placeholder', 'leftIcon', 'onValueChange', 'className', 'size', 'state'];

export const Select = forwardRef<HTMLSelectElement, SelectProps>(
  (
    {
      label,
      hint,
      error,
      options,
      placeholder,
      leftIcon,
      size,
      state,
      className,
      id,
      disabled,
      required,
      ...props
    },
    ref
  ) => {
    // Filter out props that shouldn't be passed to the native select
    const nativeProps = Object.fromEntries(
      Object.entries(props).filter(([key]) => !SELECT_PROPS_TO_OMIT.includes(key))
    );
    const generatedId = useId();
    const selectId = id || generatedId;
    const hintId = hint ? `${selectId}-hint` : undefined;
    const errorId = error ? `${selectId}-error` : undefined;
    const describedBy = [hintId, errorId].filter(Boolean).join(" ") || undefined;

    const effectiveState = error ? "error" : state;

    return (
      <div className="w-full">
        {label && (
          <label htmlFor={selectId} className="block text-sm font-medium text-[var(--color-text-secondary)] mb-1.5">
            {label}
            {required && <span className="text-[var(--color-brand-danger)] ml-1" aria-hidden="true">*</span>}
          </label>
        )}
        <div className="relative">
          {leftIcon && (
            <div className="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--color-text-muted)] pointer-events-none flex items-center">
              {leftIcon}
            </div>
          )}
          <select
            ref={ref}
            id={selectId}
            className={selectStyles({
              size,
              state: effectiveState,
              className: className || "",
            })}
            aria-describedby={describedBy}
            aria-invalid={!!error}
            disabled={disabled}
            required={required}
            value={props.value}
            onChange={(e) => {
              if (props.onChange) props.onChange(e);
              if (props.onValueChange) props.onValueChange(e.target.value);
            }}
            {...nativeProps}
          >
            {placeholder && (
              <option value="" disabled>
                {placeholder}
              </option>
            )}
            {options.map((option) => (
              <option key={option.value} value={option.value} disabled={option.disabled}>
                {option.label}
              </option>
            ))}
          </select>
          <div className="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-[var(--color-text-muted)]">
            {chevronDown}
          </div>
        </div>
        {error && (
          <p id={errorId} className="mt-1.5 text-sm text-[var(--color-brand-danger)] flex items-center gap-1.5" role="alert">
            <svg className="h-3.5 w-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={2}>
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            {error}
          </p>
        )}
        {hint && !error && (
          <p id={hintId} className="mt-1.5 text-sm text-[var(--color-text-muted)]">
            {hint}
          </p>
        )}
      </div>
    );
  }
);

Select.displayName = "Select";
</file>

<file path="apps/web/components/primitives/Toggle.tsx">
"use client";

import { forwardRef, type InputHTMLAttributes, useId } from "react";
import { tv, type VariantProps } from "tailwind-variants";

const toggleStyles = tv({
  base: `
    relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer items-center rounded-full border-2 border-[var(--color-border-strong)]
    bg-[var(--color-surface-2)]
    transition-all duration-fast ease-out
    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-primary)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--theme-background)]
    disabled:opacity-50 disabled:cursor-not-allowed
    data-[state=checked]:bg-[var(--color-brand-primary)] data-[state=checked]:border-[var(--color-brand-primary)]
    data-[state=checked]:disabled:bg-[var(--color-brand-primary)]/50 data-[state=checked]:disabled:border-[var(--color-brand-primary)]/50
  `,
  variants: {
    size: {
      sm: `h-5 w-9`,
      md: `h-6 w-11`,
      lg: `h-7 w-13`,
    },
  },
  defaultVariants: {
    size: "md",
  },
});

const thumbStyles = tv({
  base: `
    rounded-full bg-[var(--color-text-primary)] shadow-md
    transition-transform duration-fast ease-out
    data-[state=checked]:translate-x-full
  `,
  variants: {
    size: {
      sm: `h-4 w-4 translate-x-[2px]`,
      md: `h-5 w-5 translate-x-[2px]`,
      lg: `h-6 w-6 translate-x-[2px]`,
    },
  },
  defaultVariants: {
    size: "md",
  },
});

const labelStyles = tv({
  base: `
    ml-3 text-[var(--color-text-primary)] font-medium
    disabled:text-[var(--color-text-muted)]
    select-none cursor-pointer
  `,
  variants: {
    size: {
      sm: `text-sm`,
      md: `text-base`,
      lg: `text-lg`,
    },
  },
  defaultVariants: {
    size: "md",
  },
});

const descriptionStyles = tv({
  base: `
    text-[var(--color-text-muted)] ml-14 mt-0.5
  `,
  variants: {
    size: {
      sm: `text-xs`,
      md: `text-sm`,
      lg: `text-base`,
    },
  },
  defaultVariants: {
    size: "md",
  },
});

export interface ToggleProps extends Omit<InputHTMLAttributes<HTMLInputElement>, "type" | "size">, VariantProps<typeof toggleStyles> {
  label?: string;
  description?: string;
}

export const Toggle = forwardRef<HTMLInputElement, ToggleProps>(
  (
    {
      label,
      description,
      size,
      className,
      id,
      disabled,
      required,
      ...props
    },
    ref
  ) => {
    const generatedId = useId();
    const toggleId = id || generatedId;
    const descriptionId = description ? `${toggleId}-description` : undefined;

    return (
      <label htmlFor={toggleId} className="inline-flex items-start cursor-pointer select-none">
        <input
          ref={ref}
          type="checkbox"
          id={toggleId}
          role="switch"
          className={toggleStyles({ size, className })}
          disabled={disabled}
          required={required}
          aria-describedby={descriptionId}
          {...props}
        />
        <span
          className={thumbStyles({ size })}
          aria-hidden="true"
          data-state={props.checked ? "checked" : "unchecked"}
        />
        {(label || description) && (
          <div className="ml-3 min-w-0">
            {label && <span className={labelStyles({ size })}>{label}</span>}
            {description && (
              <p id={descriptionId} className={descriptionStyles({ size })}>
                {description}
              </p>
            )}
          </div>
        )}
      </label>
    );
  }
);

Toggle.displayName = "Toggle";
</file>

<file path="apps/web/components/ui/ActionList.tsx">
"use client";

import React, { Fragment, type ReactNode, type KeyboardEvent } from "react";

export interface ActionListItem {
  /** Unique item key */
  key: string;
  /** Item label */
  label: string;
  /** Item description */
  description?: string;
  /** Leading icon */
  leadingIcon?: ReactNode;
  /** Trailing element (e.g., keyboard shortcut) */
  trailing?: ReactNode;
  /** Trailing icon */
  trailingIcon?: ReactNode;
  /** Whether item is disabled */
  disabled?: boolean;
  /** Whether item is destructive */
  danger?: boolean;
  /** Whether item is a divider */
  divider?: boolean;
  /** Section label */
  section?: string;
  /** Whether item is selected */
  selected?: boolean;
  /** Whether to show checkmark when selected */
  showSelection?: boolean;
  /** Custom render function */
  render?: () => ReactNode;
}

export interface ActionListProps {
  /** Items to display */
  items: ActionListItem[];
  /** Called when item is selected */
  onSelect?: (key: string, item: ActionListItem) => void;
  /** Whether multiple items can be selected */
  multiple?: boolean;
  /** Currently selected keys (controlled) */
  selectedKeys?: Set<string>;
  /** Additional class names */
  className?: string;
  /** ARIA label for the list */
  "aria-label"?: string;
  /** Whether to show checkboxes for multiple selection */
  showCheckboxes?: boolean;
  /** Item role: menu or listbox */
  role?: "menu" | "listbox";
}

export function ActionList({
  items,
  onSelect,
  multiple = false,
  selectedKeys = new Set(),
  className = "",
  "aria-label": ariaLabel,
  showCheckboxes = false,
  role = "menu",
}: ActionListProps) {
  // Group items by section
  const groupedItems = items.reduce<Record<string, ActionListItem[]>>((acc, item) => {
    const section = item.section || "default";
    if (!acc[section]) acc[section] = [];
    acc[section].push(item);
    return acc;
  }, {});

  const handleKeyDown = (event: KeyboardEvent<HTMLElement>, item: ActionListItem, index: number, sectionItems: ActionListItem[]) => {
    const enabledItems = sectionItems.filter((i) => !i.disabled && !i.divider);
    const enabledIndices = enabledItems.map((i) => sectionItems.indexOf(i));

    switch (event.key) {
      case "Enter":
      case " ":
        event.preventDefault();
        if (!item.disabled && !item.divider) {
          handleSelect(item);
        }
        break;
      case "ArrowDown":
        event.preventDefault();
        focusNext(enabledItems, enabledIndices, index, 1);
        break;
      case "ArrowUp":
        event.preventDefault();
        focusNext(enabledItems, enabledIndices, index, -1);
        break;
      case "Home":
        event.preventDefault();
        focusIndex(enabledItems, 0);
        break;
      case "End":
        event.preventDefault();
        focusIndex(enabledItems, enabledItems.length - 1);
        break;
      case "Escape":
        event.preventDefault();
        (event.target as HTMLElement).blur();
        break;
    }
  };

  const focusNext = (enabledItems: ActionListItem[], enabledIndices: number[], currentIndex: number, direction: number) => {
    const currentEnabledIndex = enabledIndices.indexOf(currentIndex);
    const nextEnabledIndex = currentEnabledIndex + direction;
    if (nextEnabledIndex >= 0 && nextEnabledIndex < enabledItems.length) {
      const targetItem = enabledItems[nextEnabledIndex];
      const targetElement = document.querySelector(`[data-action-key="${targetItem.key}"]`) as HTMLElement;
      targetElement?.focus();
    }
  };

  const focusIndex = (enabledItems: ActionListItem[], index: number) => {
    if (enabledItems[index]) {
      const targetElement = document.querySelector(`[data-action-key="${enabledItems[index].key}"]`) as HTMLElement;
      targetElement?.focus();
    }
  };

  const handleSelect = (item: ActionListItem) => {
    if (onSelect) {
      onSelect(item.key, item);
    }
  };

  return (
    <div
      role={role}
      aria-label={ariaLabel}
      className={`action-list ${className}`}
      tabIndex={0}
    >
      {Object.entries(groupedItems).map(([sectionName, sectionItems]) => (
        <Fragment key={sectionName}>
          {sectionName !== "default" && (
            <div className="px-2 py-1.5 text-[10px] font-semibold text-[var(--color-fg-subtle)] uppercase tracking-wider">
              {sectionName}
            </div>
          )}
          {sectionItems.map((item, index) =>
            item.divider ? (
              <div key={`${sectionName}-divider-${index}`} className="h-px bg-[var(--color-border-muted)] my-1" role="separator" />
            ) : item.render ? (
              <div key={item.key} className="px-2 py-1" data-action-key={item.key} role={role === "menu" ? "menuitem" : "option"}>
                {item.render()}
              </div>
            ) : (
              <button
                key={item.key}
                type="button"
                role={role === "menu" ? "menuitem" : "option"}
                aria-selected={selectedKeys.has(item.key)}
                aria-disabled={item.disabled}
                disabled={item.disabled}
                onClick={() => handleSelect(item)}
                onKeyDown={(e) => handleKeyDown(e, item, index, sectionItems)}
                data-action-key={item.key}
                className={`
                  w-full flex items-center gap-2 px-2 py-1.5 text-sm text-[var(--color-fg-default)]
                  rounded-[var(--radius-sm)]
                  transition-colors duration-80 ease-out
                  focus-visible:outline-none focus-visible:bg-[var(--color-canvas-subtle)]
                  ${item.danger ? "text-[var(--color-danger-fg)] hover:bg-[var(--color-danger-muted)]" : "hover:bg-[var(--color-canvas-subtle)]"}
                  ${item.disabled ? "opacity-50 cursor-not-allowed" : "cursor-pointer"}
                  ${selectedKeys.has(item.key) ? "bg-[var(--color-accent-muted)]" : ""}
                `}
                tabIndex={-1}
              >
                {showCheckboxes && (
                  <span className="flex-shrink-0 h-4 w-4 flex items-center justify-center">
                    {selectedKeys.has(item.key) ? (
                      <svg className="h-3.5 w-3.5 text-[var(--color-accent-fg)]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z" />
                      </svg>
                    ) : (
                      <svg className="h-3.5 w-3.5 text-[var(--color-fg-subtle)]" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth={2} aria-hidden="true">
                        <rect x="2" y="2" width="12" height="12" rx="2" />
                      </svg>
                    )}
                  </span>
                )}
                {item.leadingIcon && <span className="flex-shrink-0 h-4 w-4" aria-hidden="true">{item.leadingIcon}</span>}
                <div className="flex-1 min-w-0 text-left">
                  <span className="truncate block">{item.label}</span>
                  {item.description && (
                    <span className="text-[11px] text-[var(--color-fg-subtle)] truncate block">{item.description}</span>
                  )}
                </div>
                {item.trailing && <span className="text-[11px] text-[var(--color-fg-subtle)] flex-shrink-0">{item.trailing}</span>}
                {item.trailingIcon && <span className="flex-shrink-0 h-4 w-4" aria-hidden="true">{item.trailingIcon}</span>}
              </button>
            )
          )}
        </Fragment>
      ))}
    </div>
  );
}

export interface ActionListItemProps {
  item: ActionListItem;
  selected?: boolean;
  onClick?: () => void;
  className?: string;
  role?: "menuitem" | "option";
}

export function ActionListItem({ item, selected = false, onClick, className = "", role = "menuitem" }: ActionListItemProps) {
  return (
    <button
      type="button"
      role={role}
      aria-selected={selected}
      aria-disabled={item.disabled}
      disabled={item.disabled}
      onClick={onClick}
      className={`
        w-full flex items-center gap-2 px-2 py-1.5 text-sm text-[var(--color-fg-default)]
        rounded-[var(--radius-sm)]
        transition-colors duration-80 ease-out
        focus-visible:outline-none focus-visible:bg-[var(--color-canvas-subtle)]
        ${item.danger ? "text-[var(--color-danger-fg)] hover:bg-[var(--color-danger-muted)]" : "hover:bg-[var(--color-canvas-subtle)]"}
        ${item.disabled ? "opacity-50 cursor-not-allowed" : "cursor-pointer"}
        ${selected ? "bg-[var(--color-accent-muted)]" : ""}
        ${className}
      `}
    >
      {item.leadingIcon && <span className="flex-shrink-0 h-4 w-4" aria-hidden="true">{item.leadingIcon}</span>}
      <div className="flex-1 min-w-0 text-left">
        <span className="truncate block">{item.label}</span>
        {item.description && (
          <span className="text-[11px] text-[var(--color-fg-subtle)] truncate block">{item.description}</span>
        )}
      </div>
      {item.trailing && <span className="text-[11px] text-[var(--color-fg-subtle)] flex-shrink-0">{item.trailing}</span>}
      {item.trailingIcon && <span className="flex-shrink-0 h-4 w-4" aria-hidden="true">{item.trailingIcon}</span>}
    </button>
  );
}

export interface ActionListSectionProps {
  /** Section label */
  label: string;
  /** Section items */
  children: ReactNode;
  /** Additional class names */
  className?: string;
}

export function ActionListSection({ label, children, className = "" }: ActionListSectionProps) {
  return (
    <div className={className}>
      <div className="px-2 py-1.5 text-[10px] font-semibold text-[var(--color-fg-subtle)] uppercase tracking-wider">
        {label}
      </div>
      <div role="group">{children}</div>
    </div>
  );
}

export interface ActionListDividerProps {
  className?: string;
}

export function ActionListDivider({ className = "" }: ActionListDividerProps) {
  return <div className={`h-px bg-[var(--color-border-muted)] my-1 ${className}`} role="separator" />;
}
</file>

<file path="apps/web/components/ui/Avatar.tsx">
"use client";

import type { ReactNode } from "react";

export interface AvatarProps {
  /** Image source */
  src?: string;
  /** Fallback text (initials, name) */
  fallback?: string;
  /** Alt text for image */
  alt?: string;
  /** Size variant */
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  /** Shape */
  shape?: "circle" | "square";
  /** Additional class names */
  className?: string;
  /** Status indicator */
  status?: "online" | "offline" | "busy" | "away";
  /** Status position */
  statusPosition?: "bottom-right" | "top-right" | "bottom-left" | "top-left";
}

const sizeClasses = {
  xs: "h-5 w-5 text-[10px]",
  sm: "h-7 w-7 text-xs",
  md: "h-8 w-8 text-sm",
  lg: "h-10 w-10 text-base",
  xl: "h-12 w-12 text-lg",
};

const statusSizes = {
  xs: "h-1.5 w-1.5",
  sm: "h-2 w-2",
  md: "h-2 w-2",
  lg: "h-2.5 w-2.5",
  xl: "h-3 w-3",
};

const statusPositions = {
  "bottom-right": "bottom-0 right-0",
  "top-right": "top-0 right-0",
  "bottom-left": "bottom-0 left-0",
  "top-left": "top-0 left-0",
};

const statusColors = {
  online: "bg-[var(--color-success-emphasis)]",
  offline: "bg-[var(--color-fg-subtle)]",
  busy: "bg-[var(--color-danger-emphasis)]",
  away: "bg-[var(--color-attention-emphasis)]",
};

export function Avatar({
  src,
  fallback,
  alt = "",
  size = "md",
  shape = "circle",
  className = "",
  status,
  statusPosition = "bottom-right",
}: AvatarProps) {
  const isCircle = shape === "circle";
  const borderRadius = isCircle ? "rounded-full" : "rounded-[var(--radius-md)]";

  // Generate color from fallback string for consistent avatar colors
  const getColorFromString = (str: string) => {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
      hash = str.charCodeAt(i) + ((hash << 5) - hash);
    }
    const hue = hash % 360;
    return `hsl(${hue}, 65%, 45%)`;
  };

  const bgColor = fallback ? getColorFromString(fallback) : "var(--color-accent-muted)";

  const initials = fallback
    ? fallback
        .split(" ")
        .map((part) => part[0])
        .join("")
        .toUpperCase()
        .slice(0, 2)
    : "?";

  return (
    <div className={`relative inline-flex ${className}`}>
      <div
        className={`inline-flex items-center justify-center select-none overflow-hidden bg-[${bgColor}] text-[var(--color-fg-on-emphasis)] font-medium ${sizeClasses[size]} ${borderRadius}`}
        aria-label={alt || fallback}
      >
        {src ? (
          <img
            src={src}
            alt={alt}
            className="h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <span aria-hidden="true">{initials}</span>
        )}
      </div>
      {status && (
        <span
          className={`
            absolute border-2 border-[var(--color-canvas)]
            ${statusSizes[size]}
            ${statusColors[status]}
            ${statusPositions[statusPosition]}
            rounded-full
          `}
          aria-label={`Status: ${status}`}
        />
      )}
    </div>
  );
}

export interface AvatarStackProps {
  /** Array of avatar sources */
  srcs: string[];
  /** Maximum number of avatars to show */
  max?: number;
  /** Size variant */
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  /** Additional class names */
  className?: string;
  /** Total count if more than max (shows as +N) */
  totalCount?: number;
}

export function AvatarStack({ srcs, max = 5, size = "md", className = "", totalCount }: AvatarStackProps) {
  const visibleAvatars = srcs.slice(0, max);
  const remainingCount = totalCount || srcs.length - max;

  return (
    <div className={`inline-flex -space-x-2 ${className}`} aria-label={`${srcs.length} avatars`}>
      {visibleAvatars.map((src, index) => (
        <Avatar key={src} src={src} size={size} className={index === 0 ? "" : "ring-2 ring-[var(--color-canvas)]"} />
      ))}
      {remainingCount > 0 && (
        <div
          className={`
            inline-flex items-center justify-center
            bg-[var(--color-canvas-subtle)] text-[var(--color-fg-muted)]
            border-2 border-[var(--color-canvas)]
            font-medium ${sizeClasses[size]} rounded-full
          `}
          aria-label={`${remainingCount} more`}
        >
          +{remainingCount}
        </div>
      )}
    </div>
  );
}
</file>

<file path="apps/web/components/ui/Badge.tsx">
"use client";

import { forwardRef, type ReactNode } from "react";

export interface BadgeProps {
  /** Badge content */
  children?: ReactNode;
  /** Visual style variant */
  variant?: "default" | "primary" | "success" | "danger" | "warning" | "done" | "muted";
  /** Tone alias for backward compatibility */
  tone?: "neutral" | "primary" | "success" | "danger" | "amber" | "secondary" | "muted" | "accent" | "default" | "warning" | "done" | string;
  /** Show colored dot indicator */
  dot?: boolean;
  /** Size variant */
  size?: "sm" | "md";
  /** Additional class names */
  className?: string;
  /** On click handler (makes badge interactive) */
  onClick?: () => void;
  /** ARIA label for interactive badges */
  "aria-label"?: string;
}

export const Badge = forwardRef<HTMLElement, BadgeProps>(function Badge(
  {
    children,
    variant,
    tone,
    dot = false,
    size = "md",
    className = "",
    onClick,
    "aria-label": ariaLabel,
  },
  ref
) {
  const toneMap: Record<string, "default" | "primary" | "success" | "danger" | "warning" | "done" | "muted"> = {
    neutral: "default",
    primary: "primary",
    success: "success",
    danger: "danger",
    amber: "warning",
    warning: "warning",
    secondary: "warning",
    muted: "muted",
    accent: "primary",
    done: "done",
    default: "default",
  };

  const resolvedVariant: "default" | "primary" | "success" | "danger" | "warning" | "done" | "muted" =
    variant || (tone ? toneMap[tone] || "default" : "default");
  const variantStyles = {
    default: `
      bg-[var(--color-canvas-subtle)] text-[var(--color-fg-muted)]
      border border-[var(--color-border-muted)]
    `,
    primary: `
      bg-[var(--color-accent-muted)] text-[var(--color-accent-fg)]
      border border-[var(--color-accent-subtle)]
    `,
    success: `
      bg-[var(--color-success-muted)] text-[var(--color-success-fg)]
      border border-[var(--color-success-subtle)]
    `,
    danger: `
      bg-[var(--color-danger-muted)] text-[var(--color-danger-fg)]
      border border-[var(--color-danger-subtle)]
    `,
    warning: `
      bg-[var(--color-attention-muted)] text-[var(--color-attention-fg)]
      border border-[var(--color-attention-subtle)]
    `,
    done: `
      bg-[var(--color-done-muted)] text-[var(--color-done-fg)]
      border border-[var(--color-done-subtle)]
    `,
    muted: `
      bg-[var(--color-canvas-muted)] text-[var(--color-fg-subtle)]
      border border-[var(--color-border-muted)]
    `,
  };

  const sizeStyles = {
    sm: "px-2 py-0.5 text-[10px]",
    md: "px-2.5 py-0.5 text-xs",
  };

  const dotColors = {
    default: "bg-[var(--color-fg-muted)]",
    primary: "bg-[var(--color-accent-fg)]",
    success: "bg-[var(--color-success-fg)]",
    danger: "bg-[var(--color-danger-fg)]",
    warning: "bg-[var(--color-attention-fg)]",
    done: "bg-[var(--color-done-fg)]",
    muted: "bg-[var(--color-fg-subtle)]",
  };

  const baseClasses = `
    inline-flex items-center gap-1.5
    font-medium leading-none
    rounded-[var(--radius-full)]
    border
    ${sizeStyles[size]}
    ${variantStyles[resolvedVariant]}
    ${className}
    ${onClick ? "cursor-pointer hover:opacity-80 active:opacity-60" : ""}
  `;

  const dotElement = dot && (
    <span
      className={`
        h-1.5 w-1.5 rounded-full flex-shrink-0
        ${dotColors[resolvedVariant]}
      `}
      aria-hidden="true"
    />
  );

  if (onClick) {
    return (
      <button
        ref={ref as React.Ref<HTMLButtonElement>}
        type="button"
        onClick={onClick}
        className={baseClasses}
        aria-label={ariaLabel}
      >
        {dotElement}
        {children}
      </button>
    );
  }

  return (
    <span ref={ref as React.Ref<HTMLSpanElement>} className={baseClasses} role="status" aria-label={ariaLabel}>
      {dotElement}
      {children}
    </span>
  );
});
Badge.displayName = "Badge";

// IssueLabel component for consistent label styling (like GitHub's issue labels)
export interface IssueLabelProps {
  children: ReactNode;
  variant?: "default" | "primary" | "success" | "danger" | "warning" | "done";
  size?: "sm" | "md";
  className?: string;
  onClick?: () => void;
  "aria-label"?: string;
}

export function IssueLabel({
  children,
  variant = "default",
  size = "md",
  className = "",
  onClick,
  "aria-label": ariaLabel,
}: IssueLabelProps) {
  return (
    <Badge variant={variant} size={size} className={className} onClick={onClick} aria-label={ariaLabel}>
      {children}
    </Badge>
  );
}

// Octicon-style icon sizes
export const iconSizes = {
  xs: "h-3 w-3",
  sm: "h-4 w-4",
  md: "h-5 w-5",
  lg: "h-6 w-6",
  xl: "h-8 w-8",
} as const;
</file>

