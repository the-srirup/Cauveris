const chevronDown = (
  <svg className="h-4 w-4 text-[var(--color-fg-muted)] pointer-events-none" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth={2} aria-hidden="true">
    <path d="M4 6l4 4 4-4" />
  </svg>
);

export interface SelectOption {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface SelectProps
  extends Omit<SelectHTMLAttributes<HTMLSelectElement>, "size">,
    VariantProps<typeof selectStyles> {
  label?: string;
  hideLabel?: boolean;
  wrapperClassName?: string;
  hint?: string;
  error?: string;
  options: SelectOption[];
  placeholder?: string;
  leadingIcon?: ReactNode;
  onValueChange?: (value: string) => void;
}

// "onChange" must be omitted here: the native props are spread onto the <select>
// *after* the composed handler below, so a caller-supplied onChange would
// clobber it and `onValueChange` would never fire.
const SELECT_PROPS_TO_OMIT = ["label", "hideLabel", "wrapperClassName", "hint", "error", "options", "placeholder", "leadingIcon", "onValueChange", "onChange", "className", "size", "state"];

export const Select = forwardRef<HTMLSelectElement, SelectProps>(
  (
    {
      label,
      hideLabel,
      wrapperClassName,
      hint,
      error,
      options,
      placeholder,
      leadingIcon,
      size,
      state,
      className,
      id,
      disabled,
      required,
      ...props
    },
    ref
  ) => {
    const nativeProps = Object.fromEntries(Object.entries(props).filter(([key]) => !SELECT_PROPS_TO_OMIT.includes(key)));
    const generatedId = useId();
    const selectId = id || generatedId;
    const hintId = hint ? `${selectId}-hint` : undefined;
    const errorId = error ? `${selectId}-error` : undefined;
    const describedBy = [hintId, errorId].filter(Boolean).join(" ") || undefined;

    const effectiveState = error ? "error" : state;

    return (
      <div className={wrapperClassName || "w-full"}>
        {label && (
          <label htmlFor={selectId} className={hideLabel ? "sr-only" : "block text-xs font-medium text-[var(--color-fg-muted)] mb-1.5"}>
            {label}
            {required && <span className="text-[var(--color-danger-fg)] ml-1" aria-hidden="true">*</span>}
          </label>
        )}
        <div className="relative">
          {leadingIcon && (
            <div className="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--color-fg-muted)] pointer-events-none flex items-center">
              {leadingIcon}
            </div>
          )}
          <select
            ref={ref}
            id={selectId}
            className={selectStyles({ size, state: effectiveState, className: className || "" })}
            aria-describedby={describedBy}
            aria-invalid={!!error}
            disabled={disabled}
            required={required}
            value={props.value}
            onChange={(e) => {
              if (props.onChange) props.onChange(e);
              if (props.onValueChange) props.onValueChange(e.target.value);
            }}
            {...nativeProps}
          >
            {placeholder && (
              <option value="" disabled>
                {placeholder}
              </option>
            )}
            {options.map((option) => (
              <option key={option.value} value={option.value} disabled={option.disabled}>
                {option.label}
              </option>
            ))}
          </select>
          <div className="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-[var(--color-fg-muted)]">
            {chevronDown}
          </div>
        </div>
        {error && (
          <p id={errorId} className="mt-1.5 text-xs text-[var(--color-danger-fg)] flex items-center gap-1.5" role="alert">
            <svg className="h-3 w-3 flex-shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zM8 15a7 7 0 1 1 0-14 7 7 0 0 1 0 14z" />
              <path d="M4.5 7.5a.75.75 0 0 1 1.06-1.06l2.94 2.94 6.94-6.94a.75.75 0 1 1 1.06 1.06l-7.5 7.5a.75.75 0 0 1-1.06 0l-3-3a.75.75 0 0 1 0-1.06z" />
            </svg>
            {error}
          </p>
        )}
        {hint && !error && (
          <p id={hintId} className="mt-1.5 text-xs text-[var(--color-fg-subtle)]">
            {hint}
          </p>
        )}
      </div>
    );
  }
);

Select.displayName = "Select";
</file>

<file path="apps/web/components/ui/Skeleton.tsx">
"use client";

export interface SkeletonProps {
  /** Width of skeleton */
  width?: string | number;
  /** Height of skeleton */
  height?: string | number;
  /** Border radius */
  radius?: "none" | "sm" | "md" | "lg" | "full";
  /** Animation variant */
  variant?: "wave" | "pulse" | "none";
  /** Additional class names */
  className?: string;
}

const radiusStyles = {
  none: "rounded-none",
  sm: "rounded-[var(--radius-sm)]",
  md: "rounded-[var(--radius-md)]",
  lg: "rounded-[var(--radius-lg)]",
  full: "rounded-full",
};

const variantStyles = {
  wave: "skeleton-wave",
  pulse: "skeleton-pulse",
  none: "",
};

export function Skeleton({
  width = "100%",
  height = "1rem",
  radius = "md",
  variant = "wave",
  className = "",
}: SkeletonProps) {
  return (
    <div
      className={`
        bg-[var(--color-canvas-subtle)]
        ${radiusStyles[radius]}
        ${variantStyles[variant]}
        ${className}
      `}
      style={{ width, height }}
      aria-hidden="true"
    />
  );
}

export interface SkeletonTextProps {
  /** Number of lines */
  lines?: number;
  /** Width of last line */
  lastLineWidth?: string;
  /** Additional class names */
  className?: string;
}

export function SkeletonText({ lines = 3, lastLineWidth = "60%", className = "" }: SkeletonTextProps) {
  return (
    <div className={`space-y-2 ${className}`} aria-hidden="true">
      {Array.from({ length: lines }).map((_, i) => (
        <Skeleton
          key={i}
          width={i === lines - 1 ? lastLineWidth : "100%"}
          height="1rem"
          radius="sm"
          variant="wave"
        />
      ))}
    </div>
  );
}

export interface SkeletonCardProps {
  /** Show header skeleton */
  header?: boolean;
  /** Number of content lines */
  lines?: number;
  /** Additional class names */
  className?: string;
}

export function SkeletonCard({ header = true, lines = 4, className = "" }: SkeletonCardProps) {
  return (
    <div className={`card-base space-y-4 ${className}`} aria-hidden="true">
      {header && (
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <Skeleton width="40px" height="40px" radius="full" variant="wave" />
            <div className="space-y-2">
              <Skeleton width="60%" height="1rem" radius="sm" variant="wave" />
              <Skeleton width="40%" height="0.75rem" radius="sm" variant="wave" />
            </div>
          </div>
          <Skeleton width="80px" height="32px" radius="sm" variant="wave" />
        </div>
      )}
      <SkeletonText lines={lines} />
    </div>
  );
}

export interface SkeletonTableProps {
  /** Number of columns */
  columns: number;
  /** Number of rows */
  rows?: number;
  /** Show header */
  header?: boolean;
  /** Additional class names */
  className?: string;
}

export function SkeletonTable({ columns, rows = 5, header = true, className = "" }: SkeletonTableProps) {
  return (
    <div className={`table-container ${className}`} aria-hidden="true">
      <table className="table">
        {header && (
          <thead>
            <tr>
              {Array.from({ length: columns }).map((_, i) => (
                <th key={i} scope="col">
                  <Skeleton width="100%" height="1rem" radius="sm" variant="wave" />
                </th>
              ))}
            </tr>
          </thead>
        )}
        <tbody>
          {Array.from({ length: rows }).map((_, rowIndex) => (
            <tr key={rowIndex}>
              {Array.from({ length: columns }).map((_, colIndex) => (
                <td key={colIndex}>
                  <Skeleton width="100%" height="1rem" radius="sm" variant="wave" />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

export interface SkeletonListProps {
  /** Number of items */
  items?: number;
  /** Show avatar */
  avatar?: boolean;
  /** Show action */
  action?: boolean;
  /** Additional class names */
  className?: string;
}

export function SkeletonList({ items = 5, avatar = true, action = false, className = "" }: SkeletonListProps) {
  return (
    <div className={`space-y-3 ${className}`} aria-hidden="true">
      {Array.from({ length: items }).map((_, i) => (
        <div key={i} className="flex items-center gap-3">
          {avatar && <Skeleton width="40px" height="40px" radius="full" variant="wave" />}
          <div className="flex-1 space-y-2">
            <Skeleton width="60%" height="1rem" radius="sm" variant="wave" />
            <Skeleton width="40%" height="0.75rem" radius="sm" variant="wave" />
          </div>
          {action && <Skeleton width="80px" height="32px" radius="sm" variant="wave" />}
        </div>
      ))}
    </div>
  );
}

export interface SkeletonPageProps {
  /** Page title */
  title?: boolean;
  /** Stats row */
  stats?: boolean;
  /** Table skeleton */
  table?: { columns: number; rows?: number };
  /** List skeleton */
  list?: { items?: number; avatar?: boolean };
  /** Additional class names */
  className?: string;
}

export function SkeletonPage({ title = true, stats = false, table, list, className = "" }: SkeletonPageProps) {
  return (
    <div className={`space-y-6 ${className}`} aria-hidden="true">
      {title && (
        <div className="flex items-center justify-between">
          <Skeleton width="300px" height="2.5rem" radius="sm" variant="wave" />
          <Skeleton width="150px" height="32px" radius="sm" variant="wave" />
        </div>
      )}
      {stats && (
        <div className="flex flex-wrap gap-4">
          {Array.from({ length: 4 }).map((_, i) => (
            <Skeleton key={i} width="180px" height="100px" radius="md" variant="wave" />
          ))}
        </div>
      )}
      {table && <SkeletonTable columns={table.columns} rows={table.rows} />}
      {list && <SkeletonList items={list.items} avatar={list.avatar} />}
    </div>
  );
}
</file>

