    {
        "event_id": "trace_2",
        "timestamp_ns": 300_000_000,
        "source_type": "otel_trace",
        "source": "traces",
        "message": "Span for /plan/compute call to planning_service",
        "attributes": {
            "service.name": "navigation_controller",
            "peer.service": "planning_service",
            "trace_id": "def456",
            "duration_ns": 450000000,
            "span.kind": "CLIENT",
        },
        "status": "error",
