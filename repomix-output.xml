<file path="apps/web/src/holographic/hooks/useForceLayout.ts">
/**
 * Hook for 3D Causal Graph Force-Directed Layout Simulation
 */

import { useState, useEffect, useRef, useCallback } from "react";
import { CausalNode, CausalLink, ForceLayoutConfig } from "../types";
import { CausalForceSimulation, DEFAULT_FORCE_CONFIG } from "../layout/forceLayout";

export function useForceLayout(
  initialNodes: CausalNode[],
  initialLinks: CausalLink[],
  customConfig: Partial<ForceLayoutConfig> = {}
) {
  const [nodes, setNodes] = useState<CausalNode[]>(initialNodes);
  const [isConverged, setIsConverged] = useState(false);
  const simRef = useRef<CausalForceSimulation | null>(null);

  useEffect(() => {
    if (!initialNodes || initialNodes.length === 0) return;

    const sim = new CausalForceSimulation({
      ...DEFAULT_FORCE_CONFIG,
      ...customConfig,
    });
    simRef.current = sim;
    setIsConverged(false);

    sim.onTick((positions) => {
      // Build from the closure's initialNodes, NOT from `prev`: nodes usually
      // arrive from a fetch AFTER mount, so the useState(initialNodes)
      // snapshot is still [] and prev.map could never adopt the real nodes
      // (the layout stayed empty forever). The closure matches the same
      // effect run that seeded the simulation.
      setNodes(
        initialNodes.map((n) => {
          const pos = positions.get(n.id);
          if (!pos) return n;
          return {
            ...n,
            position: { x: pos.x, y: pos.y, z: pos.z },
            x: pos.x,
            y: pos.y,
            z: pos.z,
          };
        })
      );
    });

    sim.onConverged(() => {
      setIsConverged(true);
    });

    sim.init(initialNodes, initialLinks);

    return () => {
      sim.stop();
      // Drop the handle so `restart()` can't resurrect a torn-down
      // simulation (after unmount it would keep ticking and firing
      // setNodes on a dead component forever).
      if (simRef.current === sim) {
        simRef.current = null;
      }
    };
  }, [initialNodes, initialLinks]);

  const restart = useCallback(() => {
    simRef.current?.restart();
    setIsConverged(false);
  }, []);

  return {
    nodes,
    isConverged,
    restart,
  };
}
</file>

<file path="apps/web/src/holographic/hooks/usePhaseRetrieval.ts">
/**
 * Hook for managing Fienup Phase Retrieval computation
 */

import { useState, useCallback, useEffect, useRef } from "react";
import { QualityMetrics } from "../types";
import { PhaseRetrievalEngine } from "../holography/phaseRetrieval";

export function usePhaseRetrieval(gridSize: number = 256) {
  const [phaseMap, setPhaseMap] = useState<Float32Array | null>(null);
  const [quality, setQuality] = useState<QualityMetrics>({
    mse: 0,
    ssim: 0,
    strehlRatio: 0,
    iterations: 0,
  });
  const [isComputing, setIsComputing] = useState(false);
  const [progress, setProgress] = useState(0);

  const engineRef = useRef<PhaseRetrievalEngine | null>(null);

  // Drop the engine reference on unmount — it holds a multi-MB Float32
  // working set plus the FFT plan, and nothing else releases it.
  useEffect(() => {
    return () => {
      engineRef.current = null;
    };
  }, []);

  const computePhase = useCallback(
    async (
      amplitudeTarget: Float32Array,
      supportMask: Float32Array,
      options: { hioIterations?: number } = {}
    ) => {
      setIsComputing(true);
      setProgress(0);

      try {
        // Recreate when the grid size changed — the old guard only built
        // when the ref was empty, so a grid change silently reused a
        // wrong-size engine and corrupted every subsequent retrieval.
        if (!engineRef.current || engineRef.current["N"] !== gridSize) {
          engineRef.current = new PhaseRetrievalEngine(gridSize);
        }

        const result = await engineRef.current.runRetrieval(amplitudeTarget, supportMask, {
          hioIterations: options.hioIterations ?? 90,
          erIterations1: 20,
          erIterations2: 20,
          onProgress: (p, metrics) => {
            setProgress(p);
            setQuality(metrics);
          },
        });

        setPhaseMap(result.phase);
        setQuality(result.metrics);
        setProgress(1.0);
        return result.phase;
      } catch (err) {
        console.error("Phase retrieval failed:", err);
        return null;
      } finally {
        setIsComputing(false);
      }
    },
    [gridSize]
  );

  return {
    phaseMap,
    quality,
    isComputing,
    progress,
    computePhase,
  };
}
</file>

<file path="apps/web/src/holographic/layout/dagLayout.ts">
/**
 * DAG Layering and Topological Ordering for Causal Graphs
 * Section 1.4 & 3.1 of Holographic Reconstruction Plan
 */

import { CausalNode, CausalLink } from "../types";

/**
 * Computes topological layers via longest path:
 * layer(v) = 1 + max{layer(u)} for all u -> v
 */
export function computeTopologicalLayers(nodes: CausalNode[], links: CausalLink[]): Map<string, number> {
  const adj = new Map<string, Set<string>>();
  const inDegree = new Map<string, number>();

  nodes.forEach((n) => {
    adj.set(n.id, new Set());
    inDegree.set(n.id, 0);
  });

  links.forEach((l) => {
    const srcId = typeof l.source === "object" ? (l.source as any).id : l.source;
    const tgtId = typeof l.target === "object" ? (l.target as any).id : l.target;
    if (adj.has(srcId) && inDegree.has(tgtId)) {
      adj.get(srcId)?.add(tgtId);
      inDegree.set(tgtId, (inDegree.get(tgtId) || 0) + 1);
    }
  });

  // Kahn processing order (parents before children) with PER-NODE depth
  // tracking: layer(v) = 1 + max{layer(u)}. A wave-counter would be plain
  // BFS layering — in graph A→B, A→C, B→C it puts C in wave 1 alongside B
  // even though C's longest causal chain is A→B→C (depth 2), collapsing
  // the two onto the same z-slab.
  const queue: string[] = [];
  const layers = new Map<string, number>();
  const depths = new Map<string, number>();

  inDegree.forEach((deg, id) => {
    if (deg === 0) {
      queue.push(id);
      depths.set(id, 0);
    }
  });

  let maxLayer = 0;
  while (queue.length > 0) {
    const id = queue.shift()!;
    const depth = depths.get(id) ?? 0;
    layers.set(id, depth);
    if (depth > maxLayer) maxLayer = depth;

    adj.get(id)?.forEach((neighbor) => {
      const newDeg = (inDegree.get(neighbor) || 0) - 1;
      inDegree.set(neighbor, newDeg);
      // Longest-path rule: neighbor can never be shallower than one past
      // its deepest processed parent.
      const candidate = depth + 1;
      if (candidate > (depths.get(neighbor) ?? 0)) depths.set(neighbor, candidate);
      if (newDeg === 0) queue.push(neighbor);
    });
  }

  // Fallback for cycles or unvisited nodes: place one slab past the deepest
  // layer real topology produced (cycle members have no valid depth).
  nodes.forEach((n) => {
    if (!layers.has(n.id)) {
      layers.set(n.id, maxLayer + 1);
    }
  });

  return layers;
}

/**
 * Assigns Z-coordinate according to topological DAG layer:
 * z = (layer - centerOffset) * layerDistance
 * Freezes z in force simulation by fixing node.fz
 */
export function applyDAGLayering(
  nodes: CausalNode[],
  layers: Map<string, number>,
  layerDistance: number = 80
): CausalNode[] {
  let maxLayer = 0;
  layers.forEach((l) => {
    if (l > maxLayer) maxLayer = l;
  });

  const centerOffset = maxLayer / 2;

  nodes.forEach((node) => {
    const layer = layers.get(node.id) ?? 0;
    node.layer = layer;
    const zPos = (layer - centerOffset) * layerDistance;
    node.position.z = zPos;
    node.z = zPos;
    node.fz = zPos; // Fixed during XY force relaxation
  });

  return nodes;
}
</file>

<file path="apps/web/src/holographic/layout/forceLayout.ts">
/**
 * 3D Force-Directed Layout Engine using d3-force-3d
 * Section 1.4 & 3.1 of Holographic Reconstruction Plan
 */

import { forceSimulation, forceManyBody, forceLink, forceCenter, forceCollide } from "d3-force-3d";
import { CausalNode, CausalLink, ForceLayoutConfig } from "../types";
import { computeTopologicalLayers, applyDAGLayering } from "./dagLayout";

export const DEFAULT_FORCE_CONFIG: ForceLayoutConfig = {
  // Barnes-Hut many-body force
  manyBodyStrength: -400,
  manyBodyTheta: 0.9,
  manyBodyDistanceMin: 10,
  manyBodyDistanceMax: 600,

  // Link spring force
  linkDistance: 70,

  // Collision
  collisionRadius: 20,
  collisionStrength: 0.7,
  collisionIterations: 2,

  // DAG & Centering
  dagMode: "zout",
  dagLevelDistance: 80,
  centerStrength: 0.05,

  // Velocity Verlet integration & cooling
  alphaDecay: 0.0228,
  velocityDecay: 0.4,
  alphaMin: 0.001,
};

export class CausalForceSimulation {
  private simulation: any = null;
  private nodes: CausalNode[] = [];
  private links: CausalLink[] = [];
  private config: ForceLayoutConfig;
  private onTickCallback?: (positions: Map<string, { x: number; y: number; z: number }>) => void;
  private onConvergedCallback?: () => void;

  constructor(config: Partial<ForceLayoutConfig> = {}) {
    this.config = { ...DEFAULT_FORCE_CONFIG, ...config };
  }

  public init(nodes: CausalNode[], links: CausalLink[]): void {
    this.stop();
    this.nodes = nodes.map((n) => ({
      ...n,
      // Deep-clone position: a shallow spread shares the same object with
      // the caller's (React) state, so the tick handler below would mutate
      // the caller's state in place.
      position: { x: n.position.x, y: n.position.y, z: n.position.z },
      // Number.isFinite, not truthiness — legitimate coordinates of 0 were
      // re-randomized on every init.
      x: Number.isFinite(n.position.x) ? n.position.x : (Math.random() - 0.5) * 100,
      y: Number.isFinite(n.position.y) ? n.position.y : (Math.random() - 0.5) * 100,
      z: Number.isFinite(n.position.z) ? n.position.z : 0,
    }));

    // Clone links to prevent mutations
    this.links = links.map((l) => ({ ...l }));

    if (this.config.dagMode === "zout") {
      const layers = computeTopologicalLayers(this.nodes, this.links);
      applyDAGLayering(this.nodes, layers, this.config.dagLevelDistance);
    }

    try {
      this.simulation = forceSimulation(this.nodes, 3)
        .force(
          "charge",
          forceManyBody()
            .strength(this.config.manyBodyStrength)
            .theta(this.config.manyBodyTheta)
            .distanceMin(this.config.manyBodyDistanceMin)
            .distanceMax(this.config.manyBodyDistanceMax)
        )
        .force(
          "link",
          forceLink(this.links)
            .id((d: any) => d.id)
            .distance(this.config.linkDistance)
        )
        .force("center", forceCenter(0, 0, 0))
        .force(
          "collide",
          forceCollide((d: any) => d.radius + 6)
            .iterations(this.config.collisionIterations)
            .strength(this.config.collisionStrength)
        )
        .alphaDecay(this.config.alphaDecay)
        .velocityDecay(this.config.velocityDecay)
        .alphaMin(this.config.alphaMin);

      this.simulation.on("tick", () => {
        const positions = new Map<string, { x: number; y: number; z: number }>();
        for (const n of this.nodes) {
          positions.set(n.id, { x: n.x ?? 0, y: n.y ?? 0, z: n.z ?? 0 });
          n.position.x = n.x ?? 0;
          n.position.y = n.y ?? 0;
          n.position.z = n.z ?? 0;
        }

        if (this.onTickCallback) {
          this.onTickCallback(positions);
        }

        if (this.simulation.alpha() < this.config.alphaMin) {
          if (this.onConvergedCallback) {
            this.onConvergedCallback();
          }
        }
      });

      this.simulation.alpha(1).restart();
    } catch (e) {
      console.warn("d3-force-3d initialization error, using analytical DAG positioning:", e);
      // Fallback layout
      this.runFallbackLayout();
    }
  }

  private runFallbackLayout(): void {
    const layers = computeTopologicalLayers(this.nodes, this.links);
    applyDAGLayering(this.nodes, layers, this.config.dagLevelDistance);

    // Distribute nodes radially on XY within each layer
    const layerGroups = new Map<number, CausalNode[]>();
    for (const n of this.nodes) {
      const l = n.layer ?? 0;
      if (!layerGroups.has(l)) layerGroups.set(l, []);
      layerGroups.get(l)!.push(n);
    }

    layerGroups.forEach((groupNodes) => {
      const count = groupNodes.length;
      const radius = Math.max(40, count * 25);
      groupNodes.forEach((node, i) => {
        const angle = (2 * Math.PI * i) / count;
        node.x = Math.cos(angle) * radius;
        node.y = Math.sin(angle) * radius;
        node.position.x = node.x;
        node.position.y = node.y;
      });
    });

    const positions = new Map<string, { x: number; y: number; z: number }>();
    for (const n of this.nodes) {
      positions.set(n.id, { x: n.position.x, y: n.position.y, z: n.position.z });
    }
    if (this.onTickCallback) this.onTickCallback(positions);
    if (this.onConvergedCallback) this.onConvergedCallback();
  }

  public onTick(cb: (positions: Map<string, { x: number; y: number; z: number }>) => void): void {
    this.onTickCallback = cb;
  }

  public onConverged(cb: () => void): void {
    this.onConvergedCallback = cb;
  }

  public stop(): void {
    if (this.simulation) {
      this.simulation.stop();
      this.simulation = null;
    }
  }

  public restart(): void {
    if (this.simulation) {
      this.simulation.alpha(0.3).restart();
    }
  }
}
</file>

<file path="apps/web/src/holographic/layout/layout.worker.ts">
/**
 * Web Worker for off-thread 3D force-directed layout simulation
 * Section 3.1 of Holographic Reconstruction Plan
 */

import { forceSimulation, forceManyBody, forceLink, forceCenter, forceCollide } from "d3-force-3d";
import { computeTopologicalLayers, applyDAGLayering } from "./dagLayout";

let simulation: any = null;

// Under lib.dom, `self` is typed as Window, whose postMessage signature takes
// (message, targetOrigin) — but this file runs in a Worker where the second
// argument is the transfer list. Assert the real worker contract once here.
const postToMain = self.postMessage.bind(self) as unknown as (
  message: unknown,
  transfer?: ArrayBuffer[]
) => void;

self.onmessage = (e: MessageEvent) => {
  const { type, nodes, links, config } = e.data;

  if (type === "INIT") {
    if (simulation) {
      simulation.stop();
    }

    const simNodes = nodes.map((n: any) => ({
      ...n,
      x: n.position?.x ?? 0,
      y: n.position?.y ?? 0,
      z: n.position?.z ?? 0,
    }));

    if (config?.dagMode === "zout") {
      const layers = computeTopologicalLayers(simNodes, links);
      applyDAGLayering(simNodes, layers, config.dagLevelDistance || 80);
    }

    try {
      simulation = forceSimulation(simNodes, 3)
        .force(
          "charge",
          forceManyBody()
            .strength(config?.manyBodyStrength ?? -400)
            .theta(config?.manyBodyTheta ?? 0.9)
        )
        .force(
          "link",
          forceLink(links)
            .id((d: any) => d.id)
            .distance(config?.linkDistance ?? 70)
        )
        .force("center", forceCenter(0, 0, 0))
        .force(
          "collide",
          forceCollide((d: any) => (d.radius || 10) + 6).iterations(
            config?.collisionIterations ?? 2
          )
        )
        .alphaDecay(config?.alphaDecay ?? 0.0228)
        .velocityDecay(config?.velocityDecay ?? 0.4)
        .alphaMin(config?.alphaMin ?? 0.001);

      simulation.on("tick", () => {
        // Pack positions into a Float32Array and transfer the buffer instead
        // of structured-cloning a per-node object array on every tick.
        const positions = new Float32Array(simNodes.length * 3);
        const ids: string[] = simNodes.map((n: any) => n.id);
        simNodes.forEach((n: any, i: number) => {
          positions[i * 3] = n.x;
          positions[i * 3 + 1] = n.y;
          positions[i * 3 + 2] = n.z;
        });

        const hasConverged = simulation.alpha() < (config?.alphaMin ?? 0.001);
        // Copy BEFORE the TICK transfer below detaches the first buffer.
        const finalPositions = hasConverged ? new Float32Array(positions) : null;

        postToMain({ type: "TICK", ids, positions }, [positions.buffer]);
        if (finalPositions) {
          postToMain(
            { type: "CONVERGED", ids, positions: finalPositions },
            [finalPositions.buffer]
          );
        }
      });

      simulation.alpha(1).restart();
    } catch (err) {
      self.postMessage({ type: "ERROR", error: String(err) });
    }
  }

  if (type === "STOP") {
    if (simulation) {
      simulation.stop();
      simulation = null;
    }
  }
};
</file>

<file path="apps/web/src/holographic/rendering/CausalGraph3D.tsx">
/**
 * 3D Causal Graph Rendering Component (React Three Fiber)
 * Section 3.1 & Day 7-8 of Holographic Reconstruction Plan
 */

import React, { useRef, useState, useMemo, useCallback, useEffect, useLayoutEffect } from "react";
import * as THREE from "three";
import { useFrame } from "@react-three/fiber";
import { Html } from "@react-three/drei";
import { CausalNode, CausalLink } from "../types";
import { getNodeColor, getLinkColor } from "../utils/colorPalettes";

// Stable emissive instances — R3F copies these into material.emissive on
// prop updates (`emissive.set(value)`), so sharing them across nodes is
// safe; the alternative was allocating fresh THREE.Colors per node on
// every render.
const EMISSIVE_SELECTED = new THREE.Color("#38bdf8");
const EMISSIVE_NONE = new THREE.Color(0x000000);

interface NodeMeshProps {
  node: CausalNode;
  isSelected: boolean;
  isHovered: boolean;
  onSelect: (id: string) => void;
  onHover: (id: string | null) => void;
}

const NodeMesh = React.memo(function NodeMesh({ node, isSelected, isHovered, onSelect, onHover }: NodeMeshProps) {
  const meshRef = useRef<THREE.Mesh>(null);
  const color = useMemo(() => getNodeColor(node.type, node.health), [node.type, node.health]);
  const hoverEmissive = useMemo(() => new THREE.Color(color).multiplyScalar(0.4), [color]);

  // Read-through for the frame loop: with React.memo this component skips
  // re-renders when hover moves elsewhere, and a memoized component's
  // useFrame closure would otherwise keep stale isSelected/isHovered.
  const visualStateRef = useRef({ isSelected, isHovered });
  visualStateRef.current = { isSelected, isHovered };

  useFrame((state) => {
    if (meshRef.current) {
      // Gentle floating animation
      meshRef.current.rotation.y = state.clock.elapsedTime * 0.3;
      const { isSelected: sel, isHovered: hov } = visualStateRef.current;
      if (sel || hov) {
        const pulse = 1.0 + 0.15 * Math.sin(state.clock.elapsedTime * 4);
        meshRef.current.scale.setScalar(pulse);
      } else {
        meshRef.current.scale.setScalar(1.0);
      }
    }
  });

  return (
    <group position={[node.position.x, node.position.y, node.position.z]}>
      <mesh
        ref={meshRef}
        onClick={(e) => {
          e.stopPropagation();
          onSelect(node.id);
        }}
        onPointerOver={(e) => {
          e.stopPropagation();
          onHover(node.id);
        }}
        onPointerOut={() => onHover(null)}
      >
        <sphereGeometry args={[node.radius || 10, 24, 24]} />
        <meshStandardMaterial
          color={color}
          emissive={isSelected ? EMISSIVE_SELECTED : isHovered ? hoverEmissive : EMISSIVE_NONE}
          emissiveIntensity={isSelected ? 0.6 : 0.2}
          roughness={0.3}
          metalness={0.2}
        />
      </mesh>

      {/* Outer selection ring */}
      {isSelected && (
        <mesh rotation={[Math.PI / 2, 0, 0]}>
          <ringGeometry args={[(node.radius || 10) * 1.3, (node.radius || 10) * 1.5, 32]} />
          <meshBasicMaterial color="#38bdf8" side={THREE.DoubleSide} transparent opacity={0.8} />
        </mesh>
      )}

      {/* Node label */}
      <Html
        distanceFactor={200}
        position={[0, (node.radius || 10) + 10, 0]}
        style={{
          pointerEvents: "none",
          transform: "translate3d(-50%, -50%, 0)",
          whiteSpace: "nowrap",
          userSelect: "none",
        }}
      >
        <div
          className={`px-2 py-0.5 rounded text-[11px] font-mono transition-all ${
            isSelected
              ? "bg-sky-500/90 text-white font-bold shadow-lg shadow-sky-500/50 scale-110"
              : isHovered
              ? "bg-slate-900/90 text-sky-300 border border-sky-400/50"
              : "bg-slate-950/70 text-slate-300 border border-slate-700/40 opacity-75"
          }`}
        >
          {node.label || node.name || node.id}
        </div>
      </Html>
    </group>
  );
});

interface LinkLineProps {
  link: CausalLink;
  nodesMap: Map<string, CausalNode>;
}

// Hover transitions re-render the whole graph — memoizing LinkLine (with
// the stable callbacks below) keeps the N links out of those renders.
const LinkLine = React.memo(function LinkLine({ link, nodesMap }: LinkLineProps) {
  const srcId = typeof link.source === "object" ? (link.source as any).id : link.source;
  const tgtId = typeof link.target === "object" ? (link.target as any).id : link.target;
  const src = nodesMap.get(srcId);
  const tgt = nodesMap.get(tgtId);

  // Create the line keyed on stable ids + style — NOT on node-object identity,
  // which changes on every force-layout tick (the previous deps rebuilt the
  // geometry + material + Line for every link on every tick and never disposed
  // the old objects). Position changes are applied in place by the
  // useLayoutEffect below.
  const lineObj = useMemo(() => {
    if (!src || !tgt) return null;

    const start = new THREE.Vector3(src.position.x, src.position.y, src.position.z);
    const end = new THREE.Vector3(tgt.position.x, tgt.position.y, tgt.position.z);

    const geom = new THREE.BufferGeometry().setFromPoints([start, end]);
    const linkColor = getLinkColor(link.strength, link.type);
    const mat = new THREE.LineBasicMaterial({
      color: linkColor,
      transparent: true,
      opacity: Math.max(0.3, Math.min(0.85, (link.strength || 0.5) + 0.2)),
    });

    return new THREE.Line(geom, mat);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [srcId, tgtId, link.strength, link.type]);

  // Release the previous geometry/material when the line is recreated or the
  // component unmounts (R3F never auto-disposes <primitive> object swaps).
  useEffect(() => {
    return () => {
      if (lineObj) {
        lineObj.geometry.dispose();
        (lineObj.material as THREE.Material).dispose();
      }
    };
  }, [lineObj]);

  // Keep the line endpoints in sync with the (per-tick) layout positions by
  // mutating the existing position buffer — no per-tick allocation.
  useLayoutEffect(() => {
    if (!lineObj || !src || !tgt) return;
    const posAttr = lineObj.geometry.getAttribute("position") as THREE.BufferAttribute;
    if (!posAttr) return;
    posAttr.setXYZ(0, src.position.x, src.position.y, src.position.z);
    posAttr.setXYZ(1, tgt.position.x, tgt.position.y, tgt.position.z);
    posAttr.needsUpdate = true;
    // needsUpdate only re-uploads the buffer; it does NOT invalidate the
    // cached boundingSphere, which three computes once from the INITIAL
    // endpoints — without this, links get wrongly frustum-culled once the
    // layout moves away from its initial centroid. (2-point geometry: cheap.)
    lineObj.geometry.computeBoundingSphere();
  });

  if (!lineObj) return null;

  return <primitive object={lineObj} />;
});

export interface CausalGraph3DProps {
  nodes: CausalNode[];
  links: CausalLink[];
  selectedNodeId: string | null;
  onNodeSelect: (id: string | null) => void;
  onNodeHover?: (id: string | null) => void;
}

export function CausalGraph3D({
  nodes,
  links,
  selectedNodeId,
  onNodeSelect,
  onNodeHover,
}: CausalGraph3DProps) {
  const [hoveredNodeId, setHoveredNodeId] = useState<string | null>(null);

  const nodesMap = useMemo(() => {
    const map = new Map<string, CausalNode>();
    nodes.forEach((n) => map.set(n.id, n));
    return map;
  }, [nodes]);

  // Stable identities so the memoized NodeMesh/LinkLine actually skip
  // renders: the old inline `onSelect={(id) => ...}` lambda had a fresh
  // identity per node per render, defeating any memoization.
  const handleHover = useCallback(
    (id: string | null) => {
      setHoveredNodeId(id);
      onNodeHover?.(id);
    },
    [onNodeHover]
  );

  const handleSelect = useCallback(
    (id: string) => onNodeSelect(id === selectedNodeId ? null : id),
    [onNodeSelect, selectedNodeId]
  );

  return (
    <group>
      {/* Links */}
      {links.map((link, idx) => {
        const srcId = typeof link.source === "object" ? (link.source as any).id : link.source;
        const tgtId = typeof link.target === "object" ? (link.target as any).id : link.target;
        return (
          <LinkLine key={`link-${srcId}-${tgtId}-${idx}`} link={link} nodesMap={nodesMap} />
        );
      })}

      {/* Nodes */}
      {nodes.map((node) => (
        <NodeMesh
          key={node.id}
          node={node}
          isSelected={node.id === selectedNodeId}
          isHovered={node.id === hoveredNodeId}
          onSelect={handleSelect}
          onHover={handleHover}
        />
      ))}
    </group>
  );
}
</file>

<file path="apps/web/src/holographic/rendering/GhostTrajectories.tsx">
/**
 * Ghost Trajectories & Counterfactual State Overlay (R3F)
 * Section 5.1 of Holographic Reconstruction Plan
 */

import React, { useRef, useMemo, useEffect } from "react";
import * as THREE from "three";
import { useFrame } from "@react-three/fiber";
import { Html } from "@react-three/drei";
import { CausalNode, CounterfactualResult } from "../types";

export interface GhostTrajectoriesProps {
  nodes: CausalNode[];
  counterfactual: CounterfactualResult | null;
  visible?: boolean;
}

/**
 * A single factual→counterfactual trajectory line. Memoized on endpoint
 * *values* so a re-render during force layout does not rebuild (and leak)
 * geometry/material/Line per tick. Disposes its GPU resources on change and
 * unmount (R3F never auto-disposes <primitive> object swaps).
 */
function GhostLine({
  from,
  to,
  color,
}: {
  from: [number, number, number];
  to: [number, number, number];
  color: string;
}) {
  const lineObj = useMemo(() => {
    const start = new THREE.Vector3(from[0], from[1], from[2]);
    const end = new THREE.Vector3(to[0], to[1], to[2]);
    const geom = new THREE.BufferGeometry().setFromPoints([start, end]);
    const mat = new THREE.LineDashedMaterial({
      color,
      dashSize: 3,
      gapSize: 2,
      transparent: true,
      opacity: 0.6,
    });
    const line = new THREE.Line(geom, mat);
    // Without computeLineDistances() LineDashedMaterial renders as a solid line.
    line.computeLineDistances();
    return line;
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [from[0], from[1], from[2], to[0], to[1], to[2], color]);

  useEffect(() => {
    return () => {
      lineObj.geometry.dispose();
      (lineObj.material as THREE.Material).dispose();
    };
  }, [lineObj]);

  return <primitive object={lineObj} />;
}

export function GhostTrajectories({
  nodes,
  counterfactual,
  visible = true,
}: GhostTrajectoriesProps) {
  const groupRef = useRef<THREE.Group>(null);

  useFrame((state) => {
    if (groupRef.current) {
      // Subtle hovering pulse
      const t = state.clock.elapsedTime;
      groupRef.current.position.y = Math.sin(t * 2) * 1.5;
    }
  });

  if (!visible || !counterfactual) return null;

  return (
    <group ref={groupRef}>
      {nodes.map((node) => {
        const ghostPos = counterfactual.ghostPositions[node.id];
        const attr = counterfactual.attribution[node.id] || 0;
        const delta = (counterfactual.counterfactualValues[node.id] ?? node.health) - node.health;

        if (!ghostPos || Math.abs(delta) < 0.005) return null;

        const isIntervened = node.id === counterfactual.interventionNode;
        const ghostColor = isIntervened
          ? "#ec4899"
          : delta > 0
          ? "#10b981"
          : "#ef4444";

        return (
          <group key={`ghost-${node.id}`}>
            {/* Ghost sphere */}
            <mesh position={[ghostPos.x, ghostPos.y, ghostPos.z]}>
              <sphereGeometry args={[(node.radius || 10) * 0.95, 20, 20]} />
              <meshStandardMaterial
                color={ghostColor}
                emissive={ghostColor}
                emissiveIntensity={0.6 + Math.min(1.0, attr * 0.4)}
                transparent
                opacity={0.45}
                depthWrite={false}
                blending={THREE.AdditiveBlending}
                roughness={0.2}
              />
            </mesh>

            {/* Trajectory line from factual to counterfactual */}
            <GhostLine
              from={[node.position.x, node.position.y, node.position.z]}
              to={[ghostPos.x, ghostPos.y, ghostPos.z]}
              color={ghostColor}
            />

            {/* Ghost delta label */}
            <Html
              distanceFactor={180}
              position={[ghostPos.x, ghostPos.y + (node.radius || 10) + 12, ghostPos.z]}
              style={{
                pointerEvents: "none",
                transform: "translate3d(-50%, -50%, 0)",
                whiteSpace: "nowrap",
              }}
            >
              <div className="px-1.5 py-0.5 rounded bg-slate-900/90 border border-slate-700 text-[10px] font-mono text-white shadow-md flex items-center gap-1">
                <span>{isIntervened ? "do(X):" : "CF:"}</span>
                <span className={delta > 0 ? "text-emerald-400 font-bold" : "text-rose-400 font-bold"}>
                  {delta > 0 ? "+" : ""}
                  {(delta * 100).toFixed(0)}%
                </span>
              </div>
            </Html>
          </group>
        );
      })}
    </group>
  );
}
</file>

<file path="apps/web/src/holographic/rendering/HologramVolume.tsx">
/**
 * Hologram Volume & Optical Reconstruction Plane
 * Section 4.3 & 4.4 of Holographic Reconstruction Plan
 */

import React, { useRef, useEffect } from "react";
import * as THREE from "three";
import { useFrame } from "@react-three/fiber";
import { createHologramMaterial } from "../holography/hologramMaterial";

export interface HologramVolumeProps {
  phaseTexture: THREE.DataTexture | null;
  sliceTexture: THREE.DataTexture | null;
  displayMode: "phase_hue" | "fringe_alarm" | "raw" | "intensity_slice";
  exposure?: number;
  planeSize?: number;
}

export function HologramVolume({
  phaseTexture,
  sliceTexture,
  displayMode,
  exposure = 1.0,
  planeSize = 240,
}: HologramVolumeProps) {
  const meshRef = useRef<THREE.Mesh>(null);
  const materialRef = useRef<THREE.ShaderMaterial | null>(null);

  const modeInt = displayMode === "fringe_alarm" ? 1 : displayMode === "raw" ? 2 : 0;

  useEffect(() => {
    if (!phaseTexture) return;

    // Resolution must match the actual texture (gridSize is 256 by default).
    // The shader's fringe-alarm gradient steps by 1/u_resolution texels, so
    // the hardcoded 512 sampled 2 texels out and skewed the aliasing
    // thresholds. DataTexture.image carries the true N x N dimensions.
    const resolution = phaseTexture.image?.width ?? 512;

    const mat = createHologramMaterial(phaseTexture, resolution, modeInt);
    materialRef.current = mat;

    if (meshRef.current) {
      meshRef.current.material = mat;
    }

    return () => {
      mat.dispose();
    };
  }, [phaseTexture, modeInt]);

  useFrame((state) => {
    if (materialRef.current) {
      materialRef.current.uniforms.u_time.value = state.clock.elapsedTime;
      materialRef.current.uniforms.u_exposure.value = exposure;
      materialRef.current.uniforms.u_mode.value = modeInt;
    }
  });

  if (displayMode === "intensity_slice" && sliceTexture) {
    return (
      <group position={[0, 0, 0]}>
        <mesh position={[0, 0, 0]} rotation={[0, 0, 0]}>
          <planeGeometry args={[planeSize, planeSize]} />
          <meshBasicMaterial
            map={sliceTexture}
            transparent
            opacity={0.88}
            side={THREE.DoubleSide}
            blending={THREE.AdditiveBlending}
          />
        </mesh>
        <gridHelper args={[planeSize * 1.2, 20, "#10b981", "#064e3b"]} position={[0, -planeSize / 2, 0]} />
      </group>
    );
  }

  return (
    <group position={[0, 0, 0]}>
      {phaseTexture ? (
        <mesh ref={meshRef} position={[0, 0, 0]}>
          <planeGeometry args={[planeSize, planeSize, 64, 64]} />
        </mesh>
      ) : (
        <mesh position={[0, 0, 0]}>
          <planeGeometry args={[planeSize, planeSize]} />
          <meshStandardMaterial color="#0f172a" wireframe transparent opacity={0.3} />
        </mesh>
      )}

      {/* Holographic aperture ring */}
      <mesh rotation={[0, 0, 0]}>
        <ringGeometry args={[planeSize * 0.7, planeSize * 0.72, 64]} />
        <meshBasicMaterial color="#38bdf8" transparent opacity={0.4} side={THREE.DoubleSide} />
      </mesh>
    </group>
  );
}
</file>

<file path="apps/web/src/holographic/workers/phaseRetrievalWorker.ts">
/**
 * Web Worker for off-thread Phase Retrieval execution
 */

import { PhaseRetrievalEngine } from "../holography/phaseRetrieval";

let engine: PhaseRetrievalEngine | null = null;
let currentGridSize = 0;

// Under lib.dom, `self` is typed as Window, whose postMessage signature takes
// (message, targetOrigin) — but this file runs in a Worker where the second
// argument is the transfer list. Assert the real worker contract once here.
const postToMain = self.postMessage.bind(self) as unknown as (
  message: unknown,
  transfer?: ArrayBuffer[]
) => void;

self.onmessage = async (e: MessageEvent) => {
  const { type, amplitudeTarget, supportMask, gridSize, options } = e.data;

  if (type === "RUN") {
    try {
      if (!engine || currentGridSize !== gridSize) {
        engine = new PhaseRetrievalEngine(gridSize);
        currentGridSize = gridSize;
      }

      const result = await engine.runRetrieval(amplitudeTarget, supportMask, {
        ...options,
        onProgress: (progress, metrics) => {
          self.postMessage({ type: "PROGRESS", progress, metrics });
        },
      });

      // getPhase() returns a fresh copy of the engine's internal buffer, so
      // moving its ArrayBuffer to the main thread costs nothing here — the
      // engine keeps working (the next RUN is unaffected).
      postToMain(
        {
          type: "COMPLETE",
          phase: result.phase,
          metrics: result.metrics,
        },
        // getPhase() allocates the array fresh (`new Float32Array(...)`), so
        // its buffer is a plain ArrayBuffer — TS only types it ArrayBufferLike.
        [result.phase.buffer as ArrayBuffer]
      );
    } catch (err) {
      self.postMessage({ type: "ERROR", error: String(err) });
    }
  }
};
</file>

<file path="cauveris/analysis/model.py">
"""
A calibrated latency model for cloud/edge perception pipelines.

The previous implementation of the "digital twin" was a forty-line function
returning ``(batching_window_ms * 0.52) + uniform(-3, 3)``.  It could not
explain the incident it was supposed to reproduce and it could not answer
counterfactual questions about any other incident.

This module replaces it with a real model:

* A **discrete-event simulation** of the perception pipeline:

      sensor capture -> [transport] -> inference server (dynamic batching)
                     -> [transport] -> subscriber queue (ROS QoS)
                     -> control-loop sampling

* The simulation parameters are **calibrated against the incident's own
  evidence** (span durations, batch-wait attributes, network CSVs, queue-depth
  series, log-derived latencies) by bounded global optimisation, and the
  residuals of that fit are reported so the model never overstates its
  confidence.

* Counterfactuals are re-simulated with modified configuration, so a patch is
  judged on what the model predicts, not on a scenario-specific rule.

The optimisation target, parameter vector and DES are all incident-agnostic.
"""

from __future__ import annotations

import heapq
import logging
import math
import random
from dataclasses import dataclass, field, asdict
from typing import Any, Dict, List, Optional, Tuple

import numpy as np

from .parameter_registry import FailureMechanism
from .statistics import Distribution, distribution

logger = logging.getLogger(__name__)

try:
    from scipy.optimize import differential_evolution, minimize
except Exception:  # pragma: no cover
    differential_evolution = None  # type: ignore
    minimize = None  # type: ignore

__all__ = [
    "TwinParameters",
    "SimulationOutcome",
    "LatencyCalibration",
    "simulate_pipeline",
    "calibrate_latency_model",
    "FAILURE_RESOURCE_EXHAUSTION",
    "FAILURE_DEPENDENCY_TIMEOUT",
    "FAILURE_LOCK_CONTENTION",
    "FAILURE_MECHANISMS",
]


#: The failure mechanisms the pipeline model knows how to reproduce.
#:
#: These are *mechanisms*, not symptoms.  A memory exhaustion and a
#: dependency timeout both present as "the request did not complete", which
#: is exactly why they need separate counters and separate remediations: the
#: fix for one does nothing for the other, and a system that can only say
#: "the request failed" cannot tell an operator which knob to turn.
#:
#: The names come from the parameter registry, so the analysis layer, the
#: simulation layer and the verification layer all count the same mechanism
#: under the same name.
FAILURE_RESOURCE_EXHAUSTION = FailureMechanism.RESOURCE_EXHAUSTION
FAILURE_DEPENDENCY_TIMEOUT = FailureMechanism.DEPENDENCY_TIMEOUT
FAILURE_LOCK_CONTENTION = FailureMechanism.LOCK_CONTENTION

#: Every mechanism the model can reproduce, in a stable order.
FAILURE_MECHANISMS: Tuple[str, ...] = FailureMechanism.ALL


@dataclass
class TwinParameters:
    """Physical parameters of the perception pipeline (all times in ms)."""

    # Sensor / producer
    arrival_rate_hz: float = 10.0
    initial_backlog_frames: float = 0.0

    # Inference service
    batching_window_ms: float = 100.0
    max_batch_size: int = 8
    server_workers: int = 1
    service_base_ms: float = 10.0
    service_per_item_ms: float = 5.0

    # Transport
    transport_mean_ms: float = 5.0
    transport_sigma_ms: float = 1.0
    transport_loss_prob: float = 0.0

    # Subscriber
    qos_queue_depth: int = 1
    consumer_rate_hz: float = 10.0

    # Time base
    clock_skew_ms: float = 0.0

    # Resource envelope.  ``resource_limit_mb`` is the ceiling the workload
    # is allowed (a container quota, a cgroup limit, a JVM heap cap);
    # ``resource_demand_mb`` is the working set it actually needs, measured
    # from the incident.  Their ratio is the pressure the service runs
    # under: at 1.0 the workload is exactly at the ceiling, and above it the
    # process is killed for exceeding its limit.
    resource_limit_mb: float = 0.0
    resource_demand_mb: float = 0.0
    # The extra service time a fully loaded worker costs.  Measured from the
    # incident: it is the difference between serving under pressure and
    # serving with headroom.
    resource_pressure_penalty_ms: float = 0.0

    # The deadline the client gives the request.  A dependency that does not
    # answer inside it does not make the caller slow - it makes the call
    # *fail*, and the work is discarded.
    request_timeout_ms: float = 0.0

    # A contended shared resource.  ``lock_contention_prob`` is the chance a
    # request has to wait for the lock, ``lock_hold_ms`` how long it is held
    # for, and ``lock_timeout_ms`` how long a caller will wait before giving
    # up on it.
    lock_contention_prob: float = 0.0
    lock_hold_ms: float = 0.0
    lock_timeout_ms: float = 0.0

    def as_dict(self) -> Dict[str, Any]:
        return {k: (round(v, 4) if isinstance(v, float) else v) for k, v in asdict(self).items()}


@dataclass
class SimulationOutcome:
    """Output of one pipeline simulation."""

    frames: int = 0
    consumed: int = 0
    dropped: int = 0
    stale_count: int = 0
    stale_rate: float = 0.0
    mean_age_ms: float = 0.0
    p50_age_ms: float = 0.0
    p90_age_ms: float = 0.0
    p95_age_ms: float = 0.0
    p99_age_ms: float = 0.0
    max_age_ms: float = 0.0
    mean_epoch_wait_ms: float = 0.0
    p95_epoch_wait_ms: float = 0.0
    mean_service_ms: float = 0.0
    mean_batch_size: float = 0.0
    mean_transport_ms: float = 0.0
    mean_backlog: float = 0.0
    max_backlog: float = 0.0
    server_utilisation: float = 0.0
    deadline_miss_rate: float = 0.0
    age_distribution: Distribution = field(default_factory=Distribution)
    #: The age of every consumed frame, in order.  The twin drives the robot
    #: with this series rather than with numbers drawn from the summary.
    age_series: List[float] = field(default_factory=list)
    #: Which of those frames were older than the freshness budget.
    stale_series: List[bool] = field(default_factory=list)
    #: The server-side request latency of every consumed frame, in order.
    request_latency_series: List[float] = field(default_factory=list)
    # Server-side request latency (batching wait + inference service).  This is
    # a different quantity from end-to-end age: it excludes the return
    # transport and the control loop's sampling delay.
    mean_request_latency_ms: float = 0.0
    p95_request_latency_ms: float = 0.0
    # Age of a frame when it reaches the subscriber, i.e. the end-to-end age
    # *before* the control loop's sampling delay.  Comparing this with
    # ``mean_age_ms`` separates "the data took too long to arrive" from "the
    # control loop acted on it late".
    mean_delivery_age_ms: float = 0.0
    p95_delivery_age_ms: float = 0.0
    mean_sampling_delay_ms: float = 0.0
    # Which limit closed each batching epoch.  A window-limited epoch means the
    # timer fired before the batch was full; a size-limited epoch means the
    # batch filled up first.  The two regimes respond oppositely to a change
    # in the batching window, so the model has to know which one it is in.
    size_limited_epochs: int = 0
    window_limited_epochs: int = 0
    frames_served: int = 0
    #: Requests that failed outright, counted by *mechanism*.  A request that
    #: never produced a result is not a slow request - it is a lost one, and
    #: conflating the two is what makes a system report "latency" for an
    #: incident that was really an out-of-memory kill.
    failed_requests: int = 0
    failure_reasons: Dict[str, int] = field(default_factory=dict)
    #: The fraction of *served* requests that failed.
    failure_rate: float = 0.0
    #: The resource pressure the workload ran under (demand / limit).  Zero
    #: when no envelope is declared.
    resource_pressure: float = 0.0

    @property
    def size_limited_fraction(self) -> float:
        total = self.size_limited_epochs + self.window_limited_epochs
        return (self.size_limited_epochs / total) if total else 0.0

    def as_dict(self) -> Dict[str, Any]:
        out = {
            k: (round(v, 4) if isinstance(v, float) else v)
            for k, v in asdict(self).items()
            if k != "age_distribution"
        }
        out["age_distribution"] = self.age_distribution.as_dict()
        return out


@dataclass
class LatencyCalibration:
    """The outcome of fitting the model to a specific incident's evidence."""

    params: TwinParameters
    score: float
    targets: Dict[str, Optional[float]] = field(default_factory=dict)
    residuals: Dict[str, Optional[float]] = field(default_factory=dict)
    fitted: Dict[str, Optional[float]] = field(default_factory=dict)
    quality: str = "uncalibrated"
    notes: List[str] = field(default_factory=list)
    #: Where the bundle's age numbers were measured: "delivery", "consumption",
    #: "server-boundary" or "unknown".  It decides which of the model's two age
    #: series the recorded age is compared with, so it is read from the
    #: evidence rather than inferred from the fit.
    age_measurement_basis: str = "unknown"
    #: The simulated value each target was actually compared with.  One entry
    #: per target, but the *stage* can differ from the target's name: a target
    #: measured at delivery is compared with the model's age at delivery, not
    #: with its age at consumption.
    compared: Dict[str, Optional[float]] = field(default_factory=dict)
    #: The target the fit missed most, and by how much (relative error).
    worst_target: Optional[str] = None
    worst_relative_error: Optional[float] = None

    def as_dict(self) -> Dict[str, Any]:
        return {
            "parameters": self.params.as_dict(),
            "score": round(self.score, 6),
            "quality": self.quality,
            "targets": {k: (None if v is None else round(v, 4)) for k, v in self.targets.items()},
            "residuals": {k: (None if v is None else round(v, 4)) for k, v in self.residuals.items()},
            "fitted": {k: (None if v is None else round(v, 4)) for k, v in self.fitted.items()},
            "compared": {k: (None if v is None else round(v, 4)) for k, v in self.compared.items()},
            "age_measurement_basis": self.age_measurement_basis,
            "worst_target": self.worst_target,
            "worst_relative_error": (
                None if self.worst_relative_error is None else round(self.worst_relative_error, 4)
            ),
            "notes": list(self.notes),
        }


# ---------------------------------------------------------------------------
# Discrete-event simulation
# ---------------------------------------------------------------------------


def _clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


def simulate_pipeline(
    params: TwinParameters,
    *,
    duration_s: float = 2.0,
    warmup_s: float = 0.0,
    seed: int = 12345,
    freshness_budget_ms: Optional[float] = None,
    control_deadline_ms: Optional[float] = None,
    age_basis: str = "delivery",
) -> SimulationOutcome:
    """
    Simulate the perception pipeline with dynamic batching.

    The simulation is event-driven.  Frames arrive as a Poisson process, wait
    for a dynamic-batching epoch (bounded by the batching window and the
    maximum batch size), are served by a single inference worker whose service
    time grows with batch size, traverse a lossy transport link, land in a
    bounded subscriber queue (ROS QoS KEEP_LAST semantics: the oldest sample is
    dropped when the buffer is full), and are finally sampled by the control
    loop.

    Args:
        params: Physical parameters of the pipeline.
        duration_s: Measurement window.
        warmup_s: Simulated time before the measurement window (to let a
            backlog reach the state the incident exhibits).
        seed: RNG seed, so results are reproducible.
        freshness_budget_ms: If given, frames older than this are counted stale.
        control_deadline_ms: If given, frames older than this count as a
            missed control deadline.

    Returns:
        A :class:`SimulationOutcome` describing the measurement window.
    """
    rng = random.Random(seed)

    lam = max(1e-3, params.arrival_rate_hz)
    window_s = max(0.0, params.batching_window_ms / 1000.0)
    max_batch = max(1, int(params.max_batch_size))
    worker_count = max(1, int(params.server_workers))
    service_base_s = max(0.0, params.service_base_ms / 1000.0)
    service_per_item_s = max(0.0, params.service_per_item_ms / 1000.0)
    transport_mean_s = max(0.0, params.transport_mean_ms / 1000.0)
    transport_sigma_s = max(0.0, params.transport_sigma_ms / 1000.0)
    loss_prob = _clamp(params.transport_loss_prob, 0.0, 1.0)
    qos_depth = max(1, int(params.qos_queue_depth))
    consumer_hz = max(1e-3, params.consumer_rate_hz)
    consumer_period_s = 1.0 / consumer_hz
    skew_s = params.clock_skew_ms / 1000.0

    # The failure mechanisms.  Each is inert until the incident's own
    # evidence gives it a value, so a bundle that declares no resource
    # envelope and no deadline is simulated exactly as it was before these
    # mechanisms existed.
    resource_limit_mb = max(0.0, params.resource_limit_mb)
    resource_demand_mb = max(0.0, params.resource_demand_mb)
    resource_pressure = (
        resource_demand_mb / resource_limit_mb if resource_limit_mb > 0 else 0.0
    )
    resource_pressure_penalty_s = max(0.0, params.resource_pressure_penalty_ms) / 1000.0
    request_timeout_s = max(0.0, params.request_timeout_ms) / 1000.0
    lock_contention_prob = _clamp(params.lock_contention_prob, 0.0, 1.0)
    lock_hold_s = max(0.0, params.lock_hold_ms) / 1000.0
    lock_timeout_s = max(0.0, params.lock_timeout_ms) / 1000.0

    total_end_s = warmup_s + duration_s
    measure_from_s = warmup_s

    # --- state -----------------------------------------------------------
    pending: List[Tuple[float, int]] = []  # (capture_time, frame_id) awaiting a batch
    busy_workers = 0
    epoch_items: List[Tuple[float, int]] = []
    epoch_deadline: Optional[float] = None
    epoch_id = 0
    capture_times: Dict[int, float] = {}
    #: The server-side request latency of every frame the server served, keyed
    #: by frame id, so that a consumed frame's latency can be recovered.
    request_latency_by_frame: Dict[int, float] = {}
    buffer: List[Tuple[float, int]] = []  # delivered frames, newest last
    next_frame_id = 0

    # --- statistics ------------------------------------------------------
    ages: List[float] = []
    epoch_waits: List[float] = []
    services: List[float] = []
    batch_sizes: List[float] = []
    transports: List[float] = []
    request_latencies: List[float] = []
    #: The request latency of each *consumed* frame, in consumption order, so
    #: it lines up with ``ages``.
    consumed_request_latencies: List[float] = []
    #: The age of each consumed frame when it reached the subscriber.
    delivery_ages: List[float] = []
    #: The age of each frame when it reached the subscriber, keyed by frame
    #: id, so the age at delivery can be reported for the frame that was
    #: actually acted on.
    delivery_age_by_frame: Dict[int, float] = {}
    sampling_delays: List[float] = []
    backlog_samples: List[float] = []
    dropped = 0
    stale = 0
    deadline_misses = 0
    consumed = 0
    busy_time = 0.0
    produced = 0
    served = 0
    size_limited_epochs = 0
    window_limited_epochs = 0
    #: Every request the server was handed, and how many of them died.
    requests_total = 0
    failed_requests = 0
    #: The failures, counted by mechanism.
    failure_reasons: Dict[str, int] = {}

    events: List[Tuple[float, int, str, Any]] = []
    seq = 0

    def push(t: float, kind: str, payload: Any = None) -> None:
        nonlocal seq
        seq += 1
        heapq.heappush(events, (t, seq, kind, payload))

    # Initial backlog: the incident's queue depth at observation start.
    for k in range(int(max(0, round(params.initial_backlog_frames)))):
        pending.append((0.0, next_frame_id))
        next_frame_id += 1

    next_arrival = rng.expovariate(lam)
    next_consume = 0.0

    push(next_arrival, "arrival")
    push(next_consume, "consume")

    def start_epoch(now: float) -> None:
        """Open a batching epoch at ``now`` and arm its window timer."""
        nonlocal epoch_items, epoch_deadline, epoch_id
        epoch_items = []
        epoch_id += 1
        epoch_deadline = now + window_s if window_s > 0 else now
        push(epoch_deadline, "epoch_timer", epoch_id)

    def dispatch(now: float, reason: str) -> None:
        """
        Close the epoch and hand the batch to a worker.

        If every worker is occupied the epoch stays open and is retried when a
        worker reports back, which is what makes the model reproduce backlog
        growth instead of silently dropping work.

        ``reason`` records *what* closed the epoch - ``"size"`` when the batch
        filled up, ``"window"`` when the timer fired.  The two regimes respond
        oppositely to a change in the batching window, so downstream code needs
        to know which one the incident was in.

        The batch then goes through the three failure mechanisms the model
        knows, in the order a real request meets them:

        1. the **resource envelope** - a workload whose working set exceeds
           its limit is killed, and the request it was serving is lost;
        2. the **lock** - a request that has to wait for a contended lock
           waits for as long as the holder keeps it, and gives up if that is
           longer than the caller's patience;
        3. the **deadline** - a request whose latency exceeds the deadline
           the caller set is cancelled, and its work is discarded.

        A request that fails at any of these produces no result at all.  It
        is not a slow request: it is a lost one, and the model counts it
        separately so that an out-of-memory incident is never reported as a
        latency problem.
        """
        nonlocal busy_workers, epoch_items, epoch_deadline
        nonlocal size_limited_epochs, window_limited_epochs, served
        nonlocal requests_total, failed_requests, failure_reasons
        if not epoch_items:
            epoch_deadline = None
            return
        if busy_workers >= worker_count:
            return  # retry when a worker frees up
        served_items = list(epoch_items)
        n = len(served_items)
        requests_total += 1

        # --- 1. the resource envelope -------------------------------------
        # The working set the incident needed, against the ceiling it was
        # given.  Above 1.0 the workload does not slow down - it dies.
        pressure = resource_pressure
        service_s = service_base_s + service_per_item_s * n
        if resource_pressure_penalty_s > 0.0:
            service_s += resource_pressure_penalty_s * pressure

        # --- 2. the lock ---------------------------------------------------
        lock_wait_s = 0.0
        if lock_contention_prob > 0.0 and rng.random() < lock_contention_prob:
            lock_wait_s = lock_hold_s

        # --- 3. the deadline -----------------------------------------------
        # ``served_items`` holds ``(capture_time, frame_id)`` pairs, so the
        # capture time is element 0.  Reading element 1 here gave the wait
        # as the difference between a timestamp and a frame counter, which
        # is a large negative number - so the deadline was never missed and
        # the mechanism never fired.
        batch_wait_s = now - served_items[0][0] if served_items else 0.0
        request_latency_s = batch_wait_s + lock_wait_s + service_s
        request_latency_ms = request_latency_s * 1000.0

        failure: Optional[str] = None
        if pressure > 1.0:
            failure = FAILURE_RESOURCE_EXHAUSTION
        elif lock_timeout_s > 0.0 and lock_wait_s > lock_timeout_s:
            failure = FAILURE_LOCK_CONTENTION
        elif request_timeout_s > 0.0 and request_latency_s > request_timeout_s:
            failure = FAILURE_DEPENDENCY_TIMEOUT

        if failure is not None:
            failed_requests += 1
            failure_reasons[failure] = failure_reasons.get(failure, 0) + 1
            if now >= measure_from_s:
                batch_sizes.append(float(n))
            # The worker is released immediately: the request died inside the
            # server, so it never occupied the worker for its service time.
            busy_workers += 1
            epoch_items = []
            epoch_deadline = None
            push(now, "server_failed", served_items)
            return

        for capture_t, fid in served_items:
            # Server-side request latency: how long the request waited for the
            # batch, plus how long the batch took to execute.  It is recorded
            # per frame so that the per-cycle series can line up with the
            # frames the control loop actually consumed.
            request_latency = ((now - capture_t) + lock_wait_s + service_s) * 1000.0
            request_latency_by_frame[fid] = request_latency
            if capture_t >= measure_from_s:
                epoch_waits.append((now - capture_t) * 1000.0)
                request_latencies.append(request_latency)
        if now >= measure_from_s:
            services.append(service_s * 1000.0)
            batch_sizes.append(float(n))
        served += n
        if reason == "size":
            size_limited_epochs += 1
        else:
            window_limited_epochs += 1
        busy_workers += 1
        epoch_items = []
        epoch_deadline = None
        push(now + service_s, "server_done", (served_items, service_s))

    while events:
        now, _, kind, payload = heapq.heappop(events)
        if now > total_end_s:
            break

        if kind == "arrival":
            capture_t = now
            fid = next_frame_id
            next_frame_id += 1
            capture_times[fid] = capture_t
            if now >= measure_from_s:
                produced += 1

            if busy_workers >= worker_count:
                # Every inference worker is occupied: the frame joins the backlog.
                pending.append((capture_t, fid))
            else:
                if not epoch_items:
                    start_epoch(now)
                epoch_items.append((capture_t, fid))
                if len(epoch_items) >= max_batch:
                    dispatch(now, "size")

            next_arrival = now + rng.expovariate(lam)
            push(next_arrival, "arrival")

        elif kind == "epoch_timer":
            # ``payload`` is the epoch generation this timer belongs to; stale
            # timers from earlier epochs are ignored.
            if payload == epoch_id and epoch_deadline is not None:
                if epoch_items:
                    dispatch(now, "window")

        elif kind == "server_done":
            completed_items, service_s = payload
            busy_workers = max(0, busy_workers - 1)
            if now >= measure_from_s:
                busy_time += service_s
            for capture_t, fid in completed_items:
                if transport_sigma_s > 0:
                    delay = rng.gauss(transport_mean_s, transport_sigma_s)
                else:
                    delay = transport_mean_s
                delay = max(0.0, delay)
                if rng.random() < loss_prob:
                    dropped += 1
                    continue
                if now >= measure_from_s:
                    transports.append(delay * 1000.0)
                push(now + delay, "deliver", fid)
            if pending:
                # A worker is free again: open the next epoch from the backlog.
                start_epoch(now)
                take = min(max_batch, len(pending))
                for _ in range(take):
                    epoch_items.append(pending.pop(0))
                if len(epoch_items) >= max_batch:
                    dispatch(now, "size")
            elif epoch_items and busy_workers < worker_count:
                dispatch(now, "size")

        elif kind == "server_failed":
            # The request died inside the server.  The worker is free again
            # and the backlog behind it gets its chance, but nothing was
            # delivered: the frames this request carried are gone, which is
            # what distinguishes a failed request from a slow one.
            busy_workers = max(0, busy_workers - 1)
            if pending:
                start_epoch(now)
                take = min(max_batch, len(pending))
                for _ in range(take):
                    epoch_items.append(pending.pop(0))
                if len(epoch_items) >= max_batch:
                    dispatch(now, "size")
            elif epoch_items and busy_workers < worker_count:
                dispatch(now, "size")

        elif kind == "deliver":
            buffer.append((now, payload))
            capture_t = capture_times.get(payload)
            if capture_t is not None:
                # The age of the frame at the subscriber's receipt, kept per
                # frame so that it can be reported for the frame the control
                # loop actually acted on rather than for every frame that
                # happened to arrive.
                delivery_age_by_frame[payload] = (now - capture_t) * 1000.0 + skew_s
            if len(buffer) > qos_depth:
                # KEEP_LAST semantics: the oldest sample is discarded so the
                # subscriber always acts on the most recent detection.
                buffer.pop(0)
                dropped += 1

        elif kind == "consume":
            if buffer:
                newest = buffer[-1]
                capture_t = capture_times.get(newest[1], newest[0])
                consumption_age_ms = (now - capture_t) * 1000.0 + skew_s
                delivery_age = delivery_age_by_frame.get(newest[1])
                effective_age = delivery_age if (age_basis == "delivery" and delivery_age is not None) else consumption_age_ms
                if now >= measure_from_s:
                    consumed += 1
                    ages.append(effective_age)
                    sampling_delays.append((now - newest[0]) * 1000.0)
                    if delivery_age is not None:
                        delivery_ages.append(delivery_age)
                    # The request latency of the frame that was consumed, so
                    # that the per-cycle series lines up with the ages.
                    consumed_request_latencies.append(
                        request_latency_by_frame.get(newest[1], 0.0)
                    )
                    if freshness_budget_ms is not None and effective_age > freshness_budget_ms:
                        stale += 1
                    if control_deadline_ms is not None and effective_age > control_deadline_ms:
                        deadline_misses += 1
                buffer.clear()  # the sample is consumed
            next_consume = now + consumer_period_s
            push(next_consume, "consume")

        # Sample the backlog continuously across the measurement window.
        if now >= measure_from_s:
            backlog_samples.append(len(pending))

    result = SimulationOutcome()
    if ages:
        dist = distribution(ages)
        result.age_distribution = dist
        result.mean_age_ms = dist.mean
        result.p50_age_ms = dist.p50
        result.p90_age_ms = dist.p90
        result.p95_age_ms = dist.p95
        result.p99_age_ms = dist.p99
        result.max_age_ms = dist.maximum
        result.consumed = len(ages)
        result.stale_count = stale
        result.stale_rate = stale / len(ages)
        result.deadline_miss_rate = deadline_misses / len(ages)
        # The per-cycle series is kept so that the twin can drive a robot
        # trajectory with the ages it actually produced, instead of with
        # numbers sampled from the distribution.
        result.age_series = list(ages)
        result.stale_series = [
            age > freshness_budget_ms
            for age in ages
            if freshness_budget_ms is not None
        ]
        result.request_latency_series = list(consumed_request_latencies)
    result.frames = produced
    result.dropped = dropped
    result.frames_served = served
    result.size_limited_epochs = size_limited_epochs
    result.window_limited_epochs = window_limited_epochs
    result.mean_epoch_wait_ms = float(np.mean(epoch_waits)) if epoch_waits else 0.0
    result.p95_epoch_wait_ms = (
        float(np.percentile(np.asarray(epoch_waits), 95)) if epoch_waits else 0.0
    )
    result.mean_service_ms = float(np.mean(services)) if services else 0.0
    result.mean_batch_size = float(np.mean(batch_sizes)) if batch_sizes else 0.0
    result.mean_transport_ms = float(np.mean(transports)) if transports else params.transport_mean_ms
    result.mean_backlog = float(np.mean(backlog_samples)) if backlog_samples else 0.0
    result.max_backlog = float(np.max(backlog_samples)) if backlog_samples else 0.0
    result.mean_request_latency_ms = (
        float(np.mean(request_latencies)) if request_latencies else 0.0
    )
    result.p95_request_latency_ms = (
        float(np.percentile(np.asarray(request_latencies), 95)) if request_latencies else 0.0
    )
    result.mean_delivery_age_ms = float(np.mean(delivery_ages)) if delivery_ages else 0.0
    result.p95_delivery_age_ms = (
        float(np.percentile(np.asarray(delivery_ages), 95)) if delivery_ages else 0.0
    )
    result.mean_sampling_delay_ms = (
        float(np.mean(sampling_delays)) if sampling_delays else 0.0
    )
    result.server_utilisation = (
        _clamp(busy_time / max(1e-9, duration_s * worker_count), 0.0, 1.0) if busy_time else 0.0
    )
    result.failed_requests = failed_requests
    result.failure_reasons = dict(failure_reasons)
    result.failure_rate = (
        failed_requests / requests_total if requests_total else 0.0
    )
    result.resource_pressure = resource_pressure
    return result


# ---------------------------------------------------------------------------
# Calibration
# ---------------------------------------------------------------------------

# Parameters that the calibration is allowed to move.  Everything else is
# either declared by the incident's configuration (batch window, batch size,
# worker count, subscriber queue depth, control-loop rate) or measured
# directly (transport, clock skew).  Fitting a declared parameter would let
# the optimiser explain the symptom by moving a knob the operator did not
# touch, which is exactly the failure mode this layer exists to avoid.
_FITTED_PARAMS = (
    "arrival_rate_hz",
    "service_base_ms",
    "service_per_item_ms",
    "transport_mean_ms",
    "transport_sigma_ms",
)

_PARAM_BOUNDS = {
    "arrival_rate_hz": (0.5, 200.0),
    "service_base_ms": (0.5, 200.0),
    "service_per_item_ms": (0.05, 40.0),
    "transport_mean_ms": (0.0, 150.0),
    "transport_sigma_ms": (0.0, 60.0),
    "qos_queue_depth": (1, 64),
    "consumer_rate_hz": (0.5, 200.0),
}

# Target weights: each target is a measured quantity in the bundle.  The
# weights encode how directly the quantity was observed.
#
# ``mean_age_ms`` is weighted highest because it is the quantity the safety
# budget is stated in, and because it is the one an operator will check the
# prediction against.  ``mean_epoch_wait_ms`` is next because it is the
# mechanism the batching window controls.
TARGET_WEIGHTS: Dict[str, float] = {
    "mean_age_ms": 3.0,
    "p95_age_ms": 1.5,
    "mean_epoch_wait_ms": 2.5,
    "mean_service_ms": 2.0,
    "mean_batch_size": 2.0,
    "mean_transport_ms": 1.0,
    "mean_backlog": 0.75,
    "mean_request_latency_ms": 2.0,
}


def _relative_error(predicted: float, target: float) -> float:
    scale = max(abs(target), 1.0)
    return (predicted - target) / scale


def _params_from_vector(
    vector: np.ndarray,
    base: TwinParameters,
) -> TwinParameters:
    """
    Build a parameter set from the optimisation vector.

    Only the free parameters come from the vector; every other parameter is
    inherited unchanged from ``base`` so that declared configuration cannot be
    silently rewritten by the fit.
    """
    values = {name: float(v) for name, v in zip(_FITTED_PARAMS, vector)}
    # Start from the base and overwrite only the fitted fields.  Naming every
    # field explicitly - as this used to - meant that any parameter added to
    # the model later was silently dropped by the calibration, so the twin
    # simulated the failure mechanisms the model could not see.  A new
    # parameter now survives calibration because it was never mentioned.
    fitted = TwinParameters(**base.as_dict())
    for name, value in values.items():
        setattr(fitted, name, value)
    return fitted


def _simulated_targets(outcome: SimulationOutcome) -> Dict[str, float]:
    """Project a simulation outcome onto the calibration target names."""
    return {
        "mean_age_ms": outcome.mean_age_ms,
        "p95_age_ms": outcome.p95_age_ms,
        "mean_epoch_wait_ms": outcome.mean_epoch_wait_ms,
        "mean_service_ms": outcome.mean_service_ms,
        "mean_batch_size": outcome.mean_batch_size,
        "mean_transport_ms": outcome.mean_transport_ms,
        "mean_backlog": outcome.mean_backlog,
        "mean_request_latency_ms": outcome.mean_request_latency_ms,
        "mean_delivery_age_ms": outcome.mean_delivery_age_ms,
    }


def _objective(
    vector: np.ndarray,
    base: TwinParameters,
    targets: Dict[str, Optional[float]],
    *,
    duration_s: float,
    freshness_budget_ms: Optional[float],
    seed: int,
    control_deadline_ms: Optional[float] = None,
    target_sim_keys: Optional[Dict[str, str]] = None,
) -> float:
    """Weighted relative-error loss between simulated and measured quantities."""
    params = _params_from_vector(vector, base)
    outcome = simulate_pipeline(
        params,
        duration_s=duration_s,
        warmup_s=duration_s,
        seed=seed,
        freshness_budget_ms=freshness_budget_ms,
        control_deadline_ms=control_deadline_ms,
    )
    simulated = _simulated_targets(outcome)
    loss = 0.0
    weight_total = 0.0
    for name, weight in TARGET_WEIGHTS.items():
        target = targets.get(name)
        if target is None:
            continue
        sim_key = (target_sim_keys or {}).get(name, name)
        if sim_key not in simulated:
            continue
        err = _relative_error(simulated[sim_key], target)
        # Huber loss keeps one badly-fit target from dominating.
        loss += weight * (abs(err) if abs(err) <= 1.0 else 1.0 + math.log(abs(err)))
        weight_total += weight
    if weight_total == 0:
        return 0.0
    # Penalise an unstable (unbounded-backlog) configuration mildly: the fit
    # should not prefer a regime where latency diverges without bound.
    if outcome.mean_backlog > 200:
        loss += 0.5
    # A model that reproduces the incident should predict staleness when the
    # incident was stale, and health when it was healthy.  Penalise a fit that
    # claims a healthy pipeline while the budget was being violated, because
    # such a model cannot support a counterfactual claim.
    if freshness_budget_ms is not None and outcome.stale_rate > 0.5:
        loss += 0.25 * (outcome.stale_rate - 0.5)
    return loss / weight_total


def _analytic_initial_guess(
    base: TwinParameters,
    usable: Dict[str, float],
) -> np.ndarray:
    """
    Derive a starting point for the search from the measurements alone.

    The identities used here are exact for the measured pipeline:
      * server-side latency = batch wait + service time;
      * end-to-end age = request latency + transport + subscriber delay;
      * Little's law: backlog = arrival rate * residence time.
    """
    mean_age = usable.get("mean_age_ms")
    wait = usable.get("mean_epoch_wait_ms")
    transport = usable.get("mean_transport_ms")
    service = usable.get("mean_service_ms")
    request = usable.get("mean_request_latency_ms")
    batch_size = usable.get("mean_batch_size")
    backlog = usable.get("mean_backlog")

    # Service time: prefer it directly, otherwise derive it from the server-side
    # request latency (which the trace reports as span duration).
    if service is None and request is not None:
        service = max(0.5, request - (wait or 0.0))
    if service is None and mean_age is not None and wait is not None:
        service = max(0.5, mean_age - wait - (transport or 0.0))
    service = service if service is not None else 10.0

    if wait is None and mean_age is not None:
        wait = max(0.0, (mean_age - service - (transport or 0.0)))
    wait = wait if wait is not None else 0.0

    transport = transport if transport is not None else 0.0

    # Service time is modelled as a fixed cost plus a per-frame cost:
    #   service(batch n) = service_base + service_per_item * n
    # One equation cannot separate the two terms, so the per-frame cost is
    # derived from the throughput the server must sustain, and the base cost
    # absorbs the remainder.
    service_base = max(0.5, service * 0.4)
    per_item = max(0.05, (service - service_base) / max(1.0, batch_size or 1.0))

    # Arrival rate.  Little's law on the observed backlog gives the arrival
    # rate directly; the server's own throughput gives a second estimate.  The
    # larger is used because the server's throughput is a ceiling, and an
    # arrival rate above it is exactly what produces a growing backlog.
    arrival_guess = base.arrival_rate_hz
    if backlog is not None and mean_age is not None and mean_age > 0:
        littles = backlog / (mean_age / 1000.0)
        arrival_guess = max(arrival_guess, littles)
    throughput = 1.0 / max(1e-3, service / 1000.0)
    arrival_guess = max(arrival_guess, throughput * max(1.0, batch_size or 1.0))

    return np.array(
        [
            _clamp(arrival_guess, *_PARAM_BOUNDS["arrival_rate_hz"]),
            _clamp(service_base, *_PARAM_BOUNDS["service_base_ms"]),
            _clamp(per_item, *_PARAM_BOUNDS["service_per_item_ms"]),
            _clamp(transport, *_PARAM_BOUNDS["transport_mean_ms"]),
            _clamp(max(1.0, transport * 0.15), *_PARAM_BOUNDS["transport_sigma_ms"]),
        ],
        dtype=float,
    )


def calibrate_latency_model(
    base: TwinParameters,
    targets: Dict[str, Optional[float]],
    *,
    duration_s: float = 1.0,
    freshness_budget_ms: Optional[float] = None,
    control_deadline_ms: Optional[float] = None,
    seed: int = 20260101,
    max_iterations: int = 42,
    age_basis: str = "actuation",
) -> LatencyCalibration:
    """
    Fit :class:`TwinParameters` to measured quantities from the evidence.

    The optimiser is a bounded global search (SciPy's differential evolution)
    started from an analytic initial guess derived from the measurements, and
    polished with Nelder-Mead.  The residual of every target is reported.

    Only the parameters the evidence does *not* pin down are fitted; declared
    configuration (batch window, batch size, worker count, subscriber depth,
    control-loop rate) is held fixed.

    ``age_basis`` declares which simulation-side quantity the measured age
    refers to: ``"delivery"`` (age observed when the frame reaches the
    subscriber) or ``"actuation"`` (age when the control loop consumes it,
    which includes the control-loop sampling delay).  Comparing a measured
    age against the other basis produces a residual that says nothing about
    the model.
    """
    notes: List[str] = []
    usable = {k: v for k, v in targets.items() if v is not None and TARGET_WEIGHTS.get(k)}

    if not usable:
        notes.append("No measurable latency targets were found; using declared configuration only.")
        return LatencyCalibration(
            params=base,
            score=float("nan"),
            targets=targets,
            residuals={},
            fitted={},
            quality="declared-configuration-only",
            notes=notes,
        )

    x0 = _analytic_initial_guess(base, usable)
    bounds = [_PARAM_BOUNDS[name] for name in _FITTED_PARAMS]
    x0 = np.array([_clamp(v, lo, hi) for v, (lo, hi) in zip(x0, bounds)], dtype=float)

    # The recorded age and the modelled age have to be the same quantity.
    # "Age" is measured at one of two places: when the frame reaches the
    # subscriber, or when the robot acts on it.  The second is larger by the
    # control loop's sampling delay, so comparing a delivery-side measurement
    # against a consumption-side simulation produces a residual that says
    # nothing about the model.  The basis is derived from how the evidence
    # measured the age (see ``_calibration_targets``).
    age_basis_normalized = "delivery" if str(age_basis).lower() == "delivery" else "actuation"

    target_sim_keys: Dict[str, str] = {}
    if age_basis_normalized == "delivery":
        target_sim_keys = {
            "mean_age_ms": "mean_delivery_age_ms",
            "p95_age_ms": "p95_delivery_age_ms",
        }

    best_vector = x0
    best_score = float("inf")

    if differential_evolution is not None:
        try:
            result = differential_evolution(
                lambda v: _objective(
                    v,
                    base,
                    targets,
                    duration_s=duration_s,
                    freshness_budget_ms=freshness_budget_ms,
                    control_deadline_ms=control_deadline_ms,
                    seed=seed,
                    target_sim_keys=target_sim_keys,
                ),
                bounds=bounds,
                seed=seed,
                maxiter=max_iterations,
                popsize=10,
                tol=0.01,
                polish=False,
                init="sobol",
            )
            best_vector = np.asarray(result.x, dtype=float)
            best_score = float(result.fun)
        except Exception as exc:  # pragma: no cover - optimiser failure fallback
            notes.append(f"Global search failed ({exc}); used local refinement only.")

    if minimize is not None:
        try:
            local = minimize(
                lambda v: _objective(
                    v,
                    base,
                    targets,
                    duration_s=duration_s,
                    freshness_budget_ms=freshness_budget_ms,
                    control_deadline_ms=control_deadline_ms,
                    seed=seed,
                    target_sim_keys=target_sim_keys,
                ),
                best_vector,
                method="Nelder-Mead",
                options={"maxiter": 400, "xatol": 1e-3, "fatol": 1e-4},
            )
            if float(local.fun) <= best_score:
                best_vector = np.asarray(local.x, dtype=float)
                best_score = float(local.fun)
        except Exception as exc:  # pragma: no cover
            notes.append(f"Local refinement failed ({exc}).")

    if best_score == float("inf"):
        best_score = _objective(
            best_vector,
            base,
            targets,
            duration_s=duration_s,
            freshness_budget_ms=freshness_budget_ms,
            control_deadline_ms=control_deadline_ms,
            seed=seed,
        )

    fitted_params = _params_from_vector(best_vector, base)

    outcome = simulate_pipeline(
        fitted_params,
        duration_s=duration_s,
        warmup_s=duration_s,
        seed=seed,
        freshness_budget_ms=freshness_budget_ms,
        control_deadline_ms=control_deadline_ms,
    )
    simulated = _simulated_targets(outcome)
    residuals = {
        name: (simulated.get(name, 0.0) - value)
        for name, value in targets.items()
        if value is not None and name in simulated
    }

    quality = _quality_label(residuals, targets)

    # A model that cannot explain the observed batch size is explaining the
    # incident with the wrong mechanism.  This is reported explicitly because
    # it changes what a counterfactual on that model means.
    observed_batch = usable.get("mean_batch_size")
    if observed_batch:
        regime = "size-limited" if outcome.size_limited_fraction > 0.5 else "window-limited"
        notes.append(
            f"Model reproduces a mean batch size of {outcome.mean_batch_size:.2f} "
            f"(observed {observed_batch:.2f}); {outcome.size_limited_fraction * 100:.0f}% of "
            f"epochs closed on batch size, so the fitted regime is {regime}."
        )
    if outcome.mean_backlog > 0.5:
        notes.append(
            f"Fitted model reproduces a mean backlog of {outcome.mean_backlog:.2f} frames "
            f"(observed {usable.get('mean_backlog', float('nan')):.2f}); the inference server "
            "is modelled as saturated."
        )

    # The end-to-end age at consumption is structurally larger than the age at
    # delivery: the control loop only acts on a detection some time after it
    # arrives.  When the recorded age matches the model's *delivery* age, the
    # bundle measured it at the subscriber's ingress rather than at the moment
    # of action, and the difference must be stated rather than absorbed into
    # the fit.
    age_target = usable.get("mean_age_ms")
    if age_target and outcome.mean_delivery_age_ms:
        age_residual = outcome.mean_age_ms - age_target
        delivery_residual = outcome.mean_delivery_age_ms - age_target
        if abs(delivery_residual) < abs(age_residual):
            notes.append(
                f"The recorded age ({age_target:.1f} ms) matches the model's age at "
                f"delivery ({outcome.mean_delivery_age_ms:.1f} ms) rather than its age at "
                f"consumption ({outcome.mean_age_ms:.1f} ms). The difference "
                f"({outcome.mean_sampling_delay_ms:.1f} ms on average) is the control loop's "
                "sampling delay: the robot acts on the newest detection it holds, which is "
                "older than the most recent one to arrive. The safety budget applies at "
                "consumption, so predictions are reported against the consumption age."
            )
    if not notes:
        notes.append(
            "Model parameters were fitted to the incident's measured latency, "
            "batch-wait, batch-size, transport and backlog quantities."
        )

    return LatencyCalibration(
        params=fitted_params,
        score=best_score,
        targets=dict(targets),
        residuals=residuals,
        fitted=simulated,
        quality=quality,
        notes=notes,
    )


def _quality_label(
    residuals: Dict[str, float],
    targets: Dict[str, Optional[float]],
) -> Tuple[str, Optional[str], Optional[float]]:
    """
    Label the fit from the relative error of every target.

    The end-to-end age is the primary target: it is the quantity the safety
    budget is written in, so a fit that misses it badly is not a good fit,
    however well it reproduces the other numbers.  Averaging the errors with
    equal weight would let four near-perfect targets hide one that is wrong
    by a third, which is the failure this label exists to prevent - so the
    mean error is taken over the *weighted* targets and the label is capped
    by the age residual.

    Returns:
        The label, the worst-fitting target, and its relative error.
    """
    errors: Dict[str, float] = {}
    for name, target in targets.items():
        if target is None or name not in residuals:
            continue
        scale = max(abs(target), 1.0)
        errors[name] = abs(residuals[name]) / scale
    if not errors:
        return "uncalibrated", None, None

    worst_target = max(errors, key=lambda name: errors[name])
    worst = errors[worst_target]
    weight_total = sum(TARGET_WEIGHTS.get(name, 1.0) for name in errors)
    mean_err = sum(
        errors[name] * TARGET_WEIGHTS.get(name, 1.0) for name in errors
    ) / weight_total

    if worst <= 0.15 and mean_err <= 0.08:
        label = "excellent"
    elif worst <= 0.35 and mean_err <= 0.18:
        label = "good"
    elif worst <= 0.75 and mean_err <= 0.40:
        label = "partial"
    else:
        label = "poor"

    # The age carries the safety claim, so it caps the label on its own.
    age_error = errors.get("mean_age_ms")
    if age_error is not None:
        if age_error > 0.5:
            label = "poor"
        elif age_error > 0.25 and label in ("excellent", "good"):
            label = "partial"

    return label, worst_target, worst
