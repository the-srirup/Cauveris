    is_active: bool = True
    created_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))

    def verify_key(self, raw_key: str) -> bool:
        return api_key_pwd_context.verify(raw_key, self.key_hash)

    def set_key(self, raw_key: str) -> None:
