                                ? "primary"
                                : report.type === "executive"
                                ? "secondary"
                                : report.type === "technical"
                                ? "success"
                                : "danger"
                            }
                            className="text-[10px]"
                          >
                            {config.label}
                          </Badge>
                        </td>
                        <td className="py-3 pr-4 hidden md:table-cell">
                          <Badge tone="muted" className="text-[10px] font-mono uppercase">
