<file path="apps/web/components/ui/Table.tsx">
"use client";

import type { ReactNode, MouseEvent, KeyboardEvent } from "react";
import { useState, useRef, useEffect } from "react";

export interface Column<T> {
  /** Unique column key */
  key: string;
  /** Column header label */
  header: string;
  /** Cell renderer */
  render?: (row: T, index: number) => ReactNode;
  /** Column width */
  width?: string;
  /** Text alignment */
  align?: "left" | "center" | "right";
  /** Whether column is sortable */
  sortable?: boolean;
  /** Whether to hide column on mobile */
  hideOnMobile?: boolean;
}

export interface TableProps<T> {
  /** Table columns */
  columns: Column<T>[];
  /** Table data rows */
  data: T[];
  /** Unique row key extractor */
  rowKey: (row: T) => string;
  /** Row click handler */
  onRowClick?: (row: T, event: MouseEvent | KeyboardEvent) => void;
  /** Selected row keys */
  selectedKeys?: Set<string>;
  /** Called when selection changes */
  onSelectionChange?: (keys: Set<string>) => void;
  /** Whether rows are selectable */
  selectable?: boolean;
  /** Loading state */
  loading?: boolean;
  /** Empty state message */
  emptyMessage?: string;
  /** Empty state icon */
  emptyIcon?: ReactNode;
  /** Additional class names */
  className?: string;
  /** ARIA label for table */
  "aria-label"?: string;
  /** Caption for accessibility */
  caption?: string;
  /** Sticky header */
  stickyHeader?: boolean;
  /** Row class name function */
  rowClassName?: (row: T, index: number) => string;
}

export function Table<T>({
  columns,
  data,
  rowKey,
  onRowClick,
  selectedKeys = new Set(),
  onSelectionChange,
  selectable = false,
  loading = false,
  emptyMessage = "No data",
  emptyIcon,
  className = "",
  "aria-label": ariaLabel,
  caption,
  stickyHeader = false,
  rowClassName,
}: TableProps<T>) {
  const handleSelectAll = () => {
    if (!onSelectionChange) return;
    const newKeys = new Set(selectedKeys);
    if (newKeys.size === data.length) {
      newKeys.clear();
    } else {
      data.forEach((row) => newKeys.add(rowKey(row)));
    }
    onSelectionChange(newKeys);
  };

  // Track previous data length to detect changes
  const prevDataLengthRef = useRef(data.length);
  useEffect(() => {
    prevDataLengthRef.current = data.length;
  }, [data.length]);

  const handleSelectRow = (row: T) => {
    if (!onSelectionChange) return;
    const key = rowKey(row);
    const newKeys = new Set(selectedKeys);
    if (newKeys.has(key)) {
      newKeys.delete(key);
    } else {
      newKeys.add(key);
    }
    onSelectionChange(newKeys);
  };

  const isRowSelected = (row: T) => selectedKeys.has(rowKey(row));

  return (
    <div className={`table-container ${className}`} role="region" aria-label={ariaLabel} tabIndex={0}>
      {caption && <caption className="sr-only">{caption}</caption>}
      <div className="overflow-x-auto">
        <table className="table" role="grid">
          <thead className={stickyHeader ? "sticky top-0 z-10" : ""}>
            <tr>
              {selectable && (
                <th scope="col" className="w-10 px-3">
                  <input
                    type="checkbox"
                    className="h-4 w-4 rounded-[var(--radius-sm)] border-[var(--color-border-default)] text-[var(--color-accent-fg)] focus:ring-[var(--color-accent-fg)] focus:ring-offset-2 focus:ring-offset-[var(--color-canvas)]"
                    checked={data.length > 0 && selectedKeys.size === data.length}
                    onChange={handleSelectAll}
                    aria-label="Select all rows"
                  />
                </th>
              )}
              {columns.map((column) => (
                <th
                  key={column.key}
                  scope="col"
                  style={{ width: column.width, textAlign: column.align }}
                  className={`
                    ${column.sortable ? "cursor-pointer select-none hover:text-[var(--color-fg-default)]" : ""}
                    ${column.hideOnMobile ? "hidden md:table-cell" : ""}
                  `}
                  aria-sort={column.sortable ? "none" : undefined}
                >
                  <div className="flex items-center gap-1.5">
                    {column.header}
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr>
                <td colSpan={columns.length + (selectable ? 1 : 0)} className="py-12 text-center">
                  <div className="inline-flex items-center gap-2 text-[var(--color-fg-muted)]">
                    <svg className="h-5 w-5 animate-spin text-[var(--color-accent-fg)]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" />
                      <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                    </svg>
                    Loading...
                  </div>
                </td>
              </tr>
            ) : data.length === 0 ? (
              <tr>
                <td colSpan={columns.length + (selectable ? 1 : 0)} className="py-12 text-center">
                  <div className="empty-state">
                    {emptyIcon || (
                      <svg className="empty-state-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M1.5 2A1.5 1.5 0 0 1 3 0.5h10A1.5 1.5 0 0 1 14.5 2v12a1.5 1.5 0 0 1-1.5 1.5H3A1.5 1.5 0 0 1 1.5 14v-12zm13.5 1a.5.5 0 0 0-.969-.206L8 7.168 3.47 3.704a.31.31 0 0 0-.21 0l-.41.401A.31.31 0 0 0 3 4.5v7.09l5.16 2.968a.5.5 0 0 0 .832 0L13 8.5v-5.5zm-2 6.5a.5.5 0 0 1 0-1h-7a.5.5 0 0 1 0 1h7z" />
                      </svg>
                    )}
                    <p className="empty-state-title">{data.length === 0 ? "No data" : "Loading..."}</p>
                    <p className="empty-state-description">{emptyMessage}</p>
                  </div>
                </td>
              </tr>
            ) : (
              data.map((row, index) => {
                const key = rowKey(row);
                const isSelected = isRowSelected(row);

                return (
                  <tr
                    key={key}
                    className={`
                      transition-colors duration-80 ease-out
                      ${isSelected ? "bg-[var(--color-accent-muted)]" : "hover:bg-[var(--color-canvas-subtle)]"}
                      ${onRowClick ? "cursor-pointer" : ""}
                      ${rowClassName ? rowClassName(row, index) : ""}
                    `}
                    onClick={(e) => onRowClick?.(row, e)}
                    onKeyDown={(e) => {
                      if ((e.key === "Enter" || e.key === " ") && onRowClick) {
                        e.preventDefault();
                        onRowClick(row, e);
                      }
                    }}
                    tabIndex={onRowClick ? 0 : undefined}
                    style={{ backgroundColor: isSelected ? "var(--color-accent-muted)" : undefined }}
                  >
                    {selectable && (
                      <td className="px-3">
                        <input
                          type="checkbox"
                          className="h-4 w-4 rounded-[var(--radius-sm)] border-[var(--color-border-default)] text-[var(--color-accent-fg)] focus:ring-[var(--color-accent-fg)] focus:ring-offset-2 focus:ring-offset-[var(--color-canvas)]"
                          checked={isSelected}
                          onChange={() => handleSelectRow(row)}
                          onClick={(e) => e.stopPropagation()}
                          aria-label={`Select row ${index + 1}`}
                        />
                      </td>
                    )}
                    {columns.map((column) => (
                      <td
                        key={column.key}
                        style={{ textAlign: column.align }}
                        className={`${column.hideOnMobile ? "hidden md:table-cell" : ""}`}
                      >
                        {column.render ? column.render(row, index) : String((row as any)[column.key])}
                      </td>
                    ))}
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}

// Helper hook for selection state
export function useTableSelection<T>() {
  const [selectedKeys, setSelectedKeys] = useState<Set<string>>(new Set());
  const [data, setData] = useState<T[]>([]);

  function syncSelection(newData: T[], rowKey: (row: T) => string) {
    setData(newData);
    // Remove keys for rows that no longer exist
    const validKeys = new Set(newData.map(rowKey));
    setSelectedKeys((prev) => {
      const newSet = new Set<string>();
      prev.forEach((key) => {
        if (validKeys.has(key)) newSet.add(key);
      });
      return newSet;
    });
  }

  return {
    selectedKeys,
    setSelectedKeys,
    data,
    setData,
    syncSelection,
  };
}
</file>

<file path="apps/web/components/ui/Tabs.tsx">
"use client";

import * as React from "react";
import type { ReactNode } from "react";

export interface TabProps {
  /** Tab label */
  label: string;
  /** Tab content */
  children: ReactNode;
  /** Tab key for identification */
  key: string;
  /** Whether tab is disabled */
  disabled?: boolean;
  /** Icon to show before label */
  icon?: ReactNode;
}

export interface TabsProps {
  /** Tab configurations */
  children: ReactNode;
  /** Default active tab key */
  defaultActiveKey?: string;
  /** Controlled active tab key */
  activeKey?: string;
  /** Called when active tab changes */
  onChange?: (key: string) => void;
  /** Visual variant */
  variant?: "default" | "bordered" | "pills";
  /** Alignment */
  align?: "start" | "center" | "end";
  /** Additional class names */
  className?: string;
  /** ARIA label for the tab list */
  "aria-label"?: string;
}

export interface TabsContextValue {
  activeKey: string;
  variant: string;
  onChange: (key: string) => void;
  registerTab: (key: string) => void;
  unregisterTab: (key: string) => void;
}

import { createContext, useContext, useState, useCallback, useRef, useEffect } from "react";

const TabsContext = createContext<TabsContextValue | null>(null);

function useTabsContext() {
  const context = useContext(TabsContext);
  if (!context) {
    throw new Error("Tabs compound components must be used within Tabs");
  }
  return context;
}

export function Tabs({
  children,
  defaultActiveKey,
  activeKey: controlledActiveKey,
  onChange,
  variant = "default",
  align = "start",
  className = "",
  "aria-label": ariaLabel,
}: TabsProps) {
  const isControlled = controlledActiveKey !== undefined;
  const [uncontrolledActiveKey, setUncontrolledActiveKey] = useState(defaultActiveKey || "");
  const activeKey = isControlled ? controlledActiveKey : uncontrolledActiveKey;
  const registeredTabs = useRef<Set<string>>(new Set());

  const handleChange = useCallback(
    (key: string) => {
      if (!isControlled) {
        setUncontrolledActiveKey(key);
      }
      onChange?.(key);
    },
    [isControlled, onChange]
  );

  const registerTab = useCallback((key: string) => {
    registeredTabs.current.add(key);
    // Auto-select first tab if none selected
    if (!activeKey && registeredTabs.current.size === 1) {
      handleChange(key);
    }
  }, [activeKey, handleChange]);

  const unregisterTab = useCallback((key: string) => {
    registeredTabs.current.delete(key);
  }, []);

  const contextValue: TabsContextValue = {
    activeKey,
    variant,
    onChange: handleChange,
    registerTab,
    unregisterTab,
  };

  const alignClasses = {
    start: "justify-start",
    center: "justify-center",
    end: "justify-end",
  };

  let hasTabList = false;
  const tabListChildren: ReactNode[] = [];
  const panelChildren: ReactNode[] = [];
  const otherChildren: ReactNode[] = [];

  React.Children.forEach(children, (child) => {
    if (!React.isValidElement(child)) {
      otherChildren.push(child);
      return;
    }
    if (child.type === TabList) {
      hasTabList = true;
      otherChildren.push(child);
    } else if (child.type === TabPanel) {
      const itemKey =
        (child.props as any).id ||
        (child.props as any).value ||
        (child.props as any).tabKey ||
        (child.key != null ? String(child.key).replace(/^\.\$/, "") : undefined);
      panelChildren.push(
        itemKey ? React.cloneElement(child, { id: itemKey, value: itemKey, tabKey: itemKey } as any) : child
      );
    } else if (child.type === TabButton || child.type === Tab) {
      const itemKey =
        (child.props as any).id ||
        (child.props as any).value ||
        (child.props as any).tabKey ||
        (child.key != null ? String(child.key).replace(/^\.\$/, "") : undefined);
      tabListChildren.push(
        itemKey ? React.cloneElement(child, { id: itemKey, value: itemKey, tabKey: itemKey } as any) : child
      );
    } else {
      otherChildren.push(child);
    }
  });

  return (
    <TabsContext.Provider value={contextValue}>
      <div className={className}>
        {hasTabList || (tabListChildren.length === 0 && panelChildren.length === 0) ? (
          children
        ) : (
          <>
            {tabListChildren.length > 0 && (
              <div
                role="tablist"
                aria-label={ariaLabel}
                className={`
                  flex ${alignClasses[align]} gap-1
                  ${variant === "bordered" ? "border-b border-[var(--color-border-default)]" : ""}
                  ${variant === "pills" ? "bg-[var(--color-canvas-subtle)] p-1 rounded-[var(--radius-md)]" : ""}
                `}
              >
                {tabListChildren}
              </div>
            )}
            {(panelChildren.length > 0 || otherChildren.length > 0) && (
              <div className="mt-4">
                {panelChildren}
                {otherChildren}
              </div>
            )}
          </>
        )}
      </div>
    </TabsContext.Provider>
  );
}

export function TabList({ children, className = "", "aria-label": ariaLabel }: { children: ReactNode; className?: string; "aria-label"?: string }) {
  const { variant } = useTabsContext();

  return (
    <div
      role="tablist"
      aria-label={ariaLabel}
      className={`
        flex gap-1
        ${className}
        ${variant === "bordered" ? "border-b border-[var(--color-border-default)]" : ""}
        ${variant === "pills" ? "bg-[var(--color-canvas-subtle)] p-1 rounded-[var(--radius-md)]" : ""}
      `}
    >
      {children}
    </div>
  );
}

export function Tab({ children, ...props }: { children: ReactNode } & Omit<TabProps, "children">) {
  return <TabButton {...props}>{children}</TabButton>;
}

export function TabButton({
  label,
  disabled = false,
  icon,
  children,
  id,
  value,
  tabKey,
  ...restProps
}: TabProps & { id?: string; value?: string; tabKey?: string }) {
  const { activeKey, variant, onChange, registerTab, unregisterTab } = useTabsContext();
  const key = id || value || tabKey || (restProps as any).key || label || "";
  const isActive = Boolean(key && activeKey === key);

  useEffect(() => {
    if (key) {
      registerTab(key);
      return () => unregisterTab(key);
    }
  }, [key, registerTab, unregisterTab]);

  const handleClick = () => {
    if (!disabled && key) {
      onChange(key);
    }
  };

  const variantStyles = {
    default: `
      ${isActive ? "text-[var(--color-accent-fg)]" : "text-[var(--color-fg-muted)]"}
      hover:text-[var(--color-fg-default)]
      border-b-2 ${isActive ? "border-[var(--color-accent-fg)]" : "border-transparent"}
      pb-2 -mb-px
    `,
    bordered: `
      ${isActive ? "text-[var(--color-accent-fg)]" : "text-[var(--color-fg-muted)]"}
      hover:text-[var(--color-fg-default)]
      border-b-2 ${isActive ? "border-[var(--color-accent-fg)]" : "border-transparent"}
      pb-2 -mb-px
    `,
    pills: `
      ${isActive ? "bg-[var(--color-canvas)] text-[var(--color-fg-default)] shadow-sm" : "text-[var(--color-fg-muted)]"}
      hover:text-[var(--color-fg-default)]
      hover:bg-[var(--color-canvas-subtle)]
      px-3 py-1.5 rounded-[var(--radius-sm)]
    `,
  };

  const baseClasses = `
    flex items-center gap-1.5
    font-medium text-sm
    transition-colors duration-80 ease-out
    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-fg)]
    focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-canvas)]
    ${disabled ? "opacity-50 cursor-not-allowed pointer-events-none" : "cursor-pointer"}
    ${variantStyles[variant as keyof typeof variantStyles] || variantStyles.default}
  `;

  return (
    <button
      role="tab"
      id={`tab-${key}`}
      aria-selected={isActive}
      aria-controls={`panel-${key}`}
      tabIndex={isActive ? 0 : -1}
      onClick={handleClick}
      disabled={disabled}
      className={baseClasses}
    >
      {icon && <span aria-hidden="true">{icon}</span>}
      {label || children}
    </button>
  );
}

export function TabPanel({
  children,
  className = "",
  id,
  value,
  tabKey,
  ...restProps
}: { children: ReactNode; key?: string; id?: string; value?: string; tabKey?: string; className?: string }) {
  const { activeKey } = useTabsContext();
  const key = id || value || tabKey || (restProps as any).key || "";
  const isActive = Boolean(key && activeKey === key);

  if (!isActive) return null;

  return (
    <div
      role="tabpanel"
      id={`panel-${key}`}
      aria-labelledby={`tab-${key}`}
      tabIndex={0}
      className={className}
    >
      {children}
    </div>
  );
}
</file>

