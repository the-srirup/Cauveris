"""
End-to-end probe over the three failure mechanisms.

The question this answers: when an incident Cauveris has never seen is fed
in, does every stage work on *that* incident's files, and does the family
the evidence names get diagnosed, patched and verified end to end?
"""
import asyncio
import shutil
import sys
import tempfile
from pathlib import Path

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent))

from cauveris.hypothesis.generator import HypothesisGenerator
from cauveris.patch.generator import PatchGenerator
from cauveris.sandbox.controller import SandboxController
from cauveris.schemas.incident import Incident
from cauveris.simulation.runner import SimulationRunner
from cauveris.verifier.engine import VerificationEngine


def write_bundle(root: Path, config, logs, metrics=None):
    (root / "config").mkdir(parents=True, exist_ok=True)
    (root / "logs").mkdir(parents=True, exist_ok=True)
    (root / "config" / "service.yaml").write_text(yaml.safe_dump(config, sort_keys=False))
    (root / "logs" / "service.log").write_text("\n".join(logs) + "\n")
    (root / "manifest.yaml").write_text(
        yaml.safe_dump({"incident_id": root.name, "title": "synthetic"})
    )
    if metrics:
        (root / "metrics").mkdir(parents=True, exist_ok=True)
        (root / "metrics" / "memory.csv").write_text(metrics)
    return root


BASE = {
    "dynamic_batching": {"batching_window_ms": 100, "max_batch_size": 8},
    "qos": {"queue_depth": 5},
    "server": {"worker_count": 2},
    "safety": {"detection_freshness_budget_ms": 400},
}

INCIDENTS = {
    "memory": {
        "id": "CAU-7001",
        "config": {**BASE, "resources": {"memory_limit_mb": 512}},
        "logs": [
            "2026-09-20T10:29:58Z WARN service: request served in 42 ms",
            "2026-09-20T10:29:59Z ERROR service: container killed: OOMKilled, "
            "memory limit exceeded (used 1400 MB of 512 MiB)",
        ],
        "metrics": (
            "timestamp,memory_used_mb,memory_total_mb,memory_utilization_percent\n"
            "2026-09-20T10:29:58Z,1100,8192,13\n"
            "2026-09-20T10:29:59Z,1400,8192,17\n"
        ),
    },
    "timeout": {
        "id": "CAU-7002",
        "config": {**BASE, "http": {"request_timeout_ms": 50}},
        "logs": [
            "2026-09-20T10:29:58Z INFO service: request served in 42 ms",
            "2026-09-20T10:29:59Z ERROR service: upstream request timed out after 50 ms "
            "(no response inside the client deadline)",
        ],
    },
    "lock": {
        "id": "CAU-7003",
        "config": {**BASE, "storage": {"lock_timeout_ms": 50}},
        "logs": [
            "2026-09-20T10:29:58Z INFO service: request served in 42 ms",
            "2026-09-20T10:29:59Z ERROR service: lock wait timeout after 50 ms "
            "(lock held for 120 ms)",
        ],
    },
}


async def run(name, spec, tmp):
    bundle = write_bundle(
        tmp / f"incident-{spec['id']}", spec["config"], spec["logs"], spec.get("metrics")
    )
    incident = Incident(
        id=spec["id"],
        title=f"synthetic {name} incident",
        manifest={},
        bundle_path=str(bundle),
    )

    print(f"\n================ {name} ({spec['id']}) ================")

    hypotheses = await HypothesisGenerator().generate(incident)
    print("hypotheses:")
    for h in hypotheses:
        print(f"  {h.hypothesis_id} conf={h.confidence_prior}")
        for c in h.proposed_changes:
            print(f"     -> {c.parameter}: {c.current_value} => {c.target_value} "
                  f"({c.file}:{c.config_key})")

    workspace = tmp / f"sandbox-{name}"
    sandbox = SandboxController(workspace_dir=workspace)
    experiments = await sandbox.plan_experiments(hypotheses, incident_id=incident.id)
    await sandbox.run_experiments(experiments)

    runner = SimulationRunner()
    experiments = await runner.run_simulations(experiments)
    print("simulation:")
    for e in experiments:
        print(f"  {e.experiment_id} repro={e.reproduction_rate:.1%}")
        print(f"     {e.conclusion}")

    generator = PatchGenerator()
    patches = await generator.generate(experiments, incident=incident)
    print("patches:")
    for p in patches:
        print(f"  {p.candidate_id} score={p.score:.2f}")
        print("     " + p.unified_diff.replace("\n", "\n     ")[:600])

    verifier = VerificationEngine(workspace_dir=tmp / f"verify-{name}")
    reports = await verifier.verify(patches, incident=incident, bundle_root=bundle)
    print("verification:")
    for r in reports:
        print(f"  {r.patch_candidate_id} verified={r.verified} details={r.details.get('checks_passed')}/9")
        for failure in r.details.get("failures", []):
            print(f"     ! {failure}")
    return reports


async def main():
    tmp = Path(tempfile.mkdtemp(prefix="cauveris_families_"))
    try:
        for name, spec in INCIDENTS.items():
            await run(name, spec, tmp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


