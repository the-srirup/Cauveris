<file path="apps/web/app/globals.css">
@import "tailwindcss";

@theme {
  /* ============================================================
     CAUVERIS - GRAPHITE NEUTRAL WITH BLUE ACCENT
     ============================================================ */

  /* Core Backgrounds (Graphite Neutral) */
  --color-canvas: #0f1419;
  --color-canvas-inset: #1a1f2e;
  --color-canvas-subtle: #242938;
  --color-canvas-muted: #2e3448;

  /* Borders */
  --color-border-default: #2e3448;
  --color-border-muted: #242938;
  --color-border-subtle: #242938;

  /* Foreground / Text */
  --color-fg-default: #e4e8ed;
  --color-fg-muted: #8b949e;
  --color-fg-subtle: #6e7681;
  --color-fg-on-emphasis: #ffffff;

  /* Brand / Accent (Blue) */
  --color-accent-fg: #58a6ff;
  --color-accent-emphasis: #58a6ff;
  --color-accent-muted: rgba(88, 166, 255, 0.12);
  --color-accent-subtle: rgba(88, 166, 255, 0.06);

  /* Success (Green) */
  --color-success-fg: #3fb950;
  --color-success-emphasis: #2ea043;
  --color-success-muted: rgba(46, 160, 67, 0.12);
  --color-success-subtle: rgba(46, 160, 67, 0.06);

  /* Danger (Red) */
  --color-danger-fg: #f85149;
  --color-danger-emphasis: #da3633;
  --color-danger-muted: rgba(218, 54, 51, 0.12);
  --color-danger-subtle: rgba(218, 54, 51, 0.06);

  /* Warning (Yellow/Amber) */
  --color-attention-fg: #d29922;
  --color-attention-emphasis: #9e6a03;
  --color-attention-muted: rgba(158, 106, 3, 0.12);
  --color-attention-subtle: rgba(158, 106, 3, 0.06);

  /* Done (Purple) */
  --color-done-fg: #a371f7;
  --color-done-emphasis: #8957e5;
  --color-done-muted: rgba(137, 87, 229, 0.12);
  --color-done-subtle: rgba(137, 87, 229, 0.06);

  /* Spacing Scale (4px base unit) */
  --space-0: 0;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-10: 40px;
  --space-12: 48px;
  --space-16: 64px;

  /* Component Spacing Tokens */
  --card-padding: var(--space-5);
  --card-gap: var(--space-5);
  --card-header-gap: var(--space-3);
  --section-gap: var(--space-8);
  --setting-row-padding: var(--space-4);
  --setting-group-gap: var(--space-4);
  --form-gap: var(--space-4);
  --form-label-gap: var(--space-2);
  --input-padding: 8px 14px;
  --button-gap: var(--space-2);
  --icon-gap: var(--space-2);
  --badge-gap: var(--space-1);
  --divider-margin: var(--space-5);
  --sidebar-nav-gap: var(--space-1);
  --sidebar-group-gap: var(--space-4);

  /* Border Radius */
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;
  --radius-xl: 12px;
  --radius-full: 9999px;

  /* Typography - Geist Sans / Geist Mono */
  --font-sans: "Geist", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-stack: var(--font-sans);
  --font-mono: "Geist Mono", "SFMono-Regular", "Cascadia Code", "Roboto Mono", Consolas, monospace;

  /* Type Scale - Scaled for high legibility engineering interface */
  --text-xs: 12px;    --text-xs-lh: 18px;
  --text-sm: 13.5px;  --text-sm-lh: 20px;
  --text-md: 15px;    --text-md-lh: 22px;
  --text-lg: 17px;    --text-lg-lh: 26px;
  --text-xl: 21px;    --text-xl-lh: 30px;
  --text-2xl: 25px;   --text-2xl-lh: 34px;
  --text-3xl: 30px;   --text-3xl-lh: 38px;

  /* Font Weights */
  --weight-normal: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* Line Heights */
  --leading-tight: 1.25;
  --leading-normal: 1.5;
  --leading-relaxed: 1.625;

  /* Shadows */
  --shadow-sm: 0 1px 2px rgba(1, 4, 9, 0.3);
  --shadow-md: 0 4px 8px rgba(1, 4, 9, 0.3);
  --shadow-lg: 0 8px 24px rgba(1, 4, 9, 0.4);
  --shadow-focus: 0 0 0 3px rgba(88, 166, 255, 0.4);

  /* Centralized Intentional Layer / Z-Index Scale */
  --z-background: 0;
  --z-content: 1;
  --z-base: 1;
  --z-sticky: 10;
  --z-navbar: 20;
  --z-sidebar: 20;
  --z-nav-sidebar: 20;
  --z-dropdown: 30;
  --z-drawer: 40;
  --z-modal-backdrop: 50;
  --z-modal: 60;
  --z-palette: 60;
  --z-tooltip: 70;
  --z-notification: 80;

  /* Centralized Application Shell Tokens */
  --sidebar-expanded-width: 240px;
  --sidebar-collapsed-width: 64px;
  --active-sidebar-width: 240px;
  --topbar-height: 48px;
  --right-inspector-width: 360px;
  --activity-tray-closed-height: 32px;
  --activity-tray-expanded-height: 320px;
  --page-padding-x: 24px;
  --page-padding-y: 20px;
  --panel-gap: 16px;
  --control-height-sm: 28px;
  --control-height-md: 32px;

  /* Backward Compatibility Aliases */
  --shell-sidebar-width: var(--sidebar-expanded-width);
  --shell-sidebar-collapsed-width: var(--sidebar-collapsed-width);
  --shell-inspector-width: var(--right-inspector-width);
  --shell-topbar-height: var(--topbar-height);
  --shell-tray-closed-height: var(--activity-tray-closed-height);
  --shell-tray-expanded-height: var(--activity-tray-expanded-height);

  /* Animation Durations */
  --duration-fast: 80ms;
  --duration-normal: 120ms;
  --duration-slow: 200ms;
  --easing-standard: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --easing-emphasized: cubic-bezier(0.05, 0.7, 0.1, 1);

  /* Semantic aliases for backward compatibility */
  --color-background: var(--color-canvas);
  --color-surface: var(--color-canvas-inset);
  --color-surface-2: var(--color-canvas-subtle);
  --color-foreground: var(--color-fg-default);
  --color-muted: var(--color-fg-muted);
  --color-primary: var(--color-accent-emphasis);
  --color-primary-hover: var(--color-accent-fg);
  --color-primary-dim: var(--color-accent-muted);
  --color-secondary: var(--color-attention-emphasis);
  --color-success: var(--color-success-emphasis);
  --color-danger: var(--color-danger-emphasis);

  --color-brand-primary: var(--color-accent-emphasis);
  --color-brand-success: var(--color-success-emphasis);
  --color-brand-danger: var(--color-danger-emphasis);
  --color-brand-warning: var(--color-attention-emphasis);
  --color-brand-info: var(--color-accent-emphasis);

  --color-semantic-background: var(--color-canvas);
  --color-semantic-surface: var(--color-canvas-inset);
  --color-semantic-surface-elevated: var(--color-canvas-subtle);
  --color-text-primary: var(--color-fg-default);
  --color-text-secondary: var(--color-fg-muted);
  --color-text-muted: var(--color-fg-subtle);
  --color-border: var(--color-border-default);
  --color-border-strong: var(--color-border-muted);

  --color-accent-primary: var(--color-accent-emphasis);
  --color-accent-secondary: var(--color-attention-emphasis);
  --color-accent-success: var(--color-success-emphasis);
  --color-accent-amber: var(--color-attention-emphasis);

  /* Evidence Type Tokens */
  --color-evidence-observed: var(--color-fg-muted);
  --color-evidence-normalized: var(--color-fg-muted);
  --color-evidence-inferred: var(--color-attention-emphasis);
  --color-evidence-reconstructed: var(--color-fg-muted);
  --color-evidence-simulated: var(--color-success-emphasis);
  --color-evidence-reproduced: var(--color-success-emphasis);
  --color-evidence-verified: var(--color-success-emphasis);
  --color-evidence-contradicted: var(--color-danger-emphasis);
  --color-evidence-unavailable: var(--color-fg-subtle);

  /* Pipeline Status Tokens */
  --color-pipeline-pending: var(--color-fg-muted);
  --color-pipeline-running: var(--color-fg-default);
  --color-pipeline-completed: var(--color-success-emphasis);
  --color-pipeline-failed: var(--color-danger-emphasis);
  --color-pipeline-warning: var(--color-attention-emphasis);
  --color-pipeline-cancelled: var(--color-danger-emphasis);

  /* Severity Tokens */
  --color-severity-critical: var(--color-danger-emphasis);
  --color-severity-high: var(--color-danger-emphasis);
  --color-severity-medium: var(--color-attention-emphasis);
  --color-severity-low: var(--color-fg-muted);
  --color-severity-info: var(--color-fg-muted);

  /* Confidence Tokens */
  --color-confidence-veryLow: var(--color-danger-emphasis);
  --color-confidence-low: var(--color-danger-emphasis);
  --color-confidence-medium: var(--color-attention-emphasis);
  --color-confidence-high: var(--color-fg-default);
  --color-confidence-veryHigh: var(--color-success-emphasis);

  /* Dynamic theme variables */
  --color-accent: var(--color-accent-emphasis);
  --color-accent-hover: var(--color-accent-fg);
  --color-accent-dim: var(--color-accent-muted);
}

/* ============================================================
   LIGHT MODE TOKENS - GRAPHITE NEUTRAL WITH BLUE ACCENT
   ============================================================ */

@media (prefers-color-scheme: light) {
  :root {
    /* Core Backgrounds (Light Graphite) */
    --color-canvas: #f8f9fc;
    --color-canvas-inset: #ffffff;
    --color-canvas-subtle: #edf0f5;
    --color-canvas-muted: #dbe1ea;

    /* Borders */
    --color-border-default: #dbe1ea;
    --color-border-muted: #edf0f5;
    --color-border-subtle: #edf0f5;

    /* Foreground / Text */
    --color-fg-default: #1a202c;
    --color-fg-muted: #6e7681;
    --color-fg-subtle: #8b949e;
    --color-fg-on-emphasis: #ffffff;

    /* Brand / Accent (Blue) */
    --color-accent-fg: #0969da;
    --color-accent-emphasis: #0969da;
    --color-accent-muted: rgba(9, 105, 218, 0.1);
    --color-accent-subtle: rgba(9, 105, 218, 0.05);

    /* Success (Green) */
    --color-success-fg: #1a7f37;
    --color-success-emphasis: #1a7f37;
    --color-success-muted: rgba(26, 127, 55, 0.1);
    --color-success-subtle: rgba(26, 127, 55, 0.05);

    /* Danger (Red) */
    --color-danger-fg: #cf222e;
    --color-danger-emphasis: #cf222e;
    --color-danger-muted: rgba(207, 34, 46, 0.1);
    --color-danger-subtle: rgba(207, 34, 46, 0.05);

    /* Warning (Yellow/Amber) */
    --color-attention-fg: #9a6700;
    --color-attention-emphasis: #9a6700;
    --color-attention-muted: rgba(154, 103, 0, 0.1);
    --color-attention-subtle: rgba(154, 103, 0, 0.05);

    /* Done (Purple) */
    --color-done-fg: #8250df;
    --color-done-emphasis: #8250df;
    --color-done-muted: rgba(130, 80, 223, 0.1);
    --color-done-subtle: rgba(130, 80, 223, 0.05);

    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(1, 4, 9, 0.1);
    --shadow-md: 0 4px 8px rgba(1, 4, 9, 0.1);
    --shadow-lg: 0 8px 24px rgba(1, 4, 9, 0.12);
    --shadow-focus: 0 0 0 3px rgba(9, 105, 218, 0.4);
  }
}

/* ============================================================
   BASE STYLES - GITHUB DARK MODE
   ============================================================ */

@layer base {
  * {
    border-color: var(--color-border-default);
  }

  :root {
    color-scheme: dark light;
    --color-accent: var(--color-accent-emphasis);
    --color-accent-hover: var(--color-accent-fg);
    --color-accent-dim: var(--color-accent-muted);
  }

  body {
    background: var(--color-canvas);
    color: var(--color-fg-default);
    font-family: var(--font-stack);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    font-feature-settings: "rlig" 1, "calt" 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background: var(--color-accent-muted);
  }

  /* Scrollbar - GitHub Style */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--color-border-default);
    border-radius: 4px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-fg-subtle);
    border-radius: 4px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  ::-webkit-scrollbar-corner {
    background: transparent;
  }

  /* Focus Visible - GitHub Style */
  :focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  .reduced-motion *,
  .reduced-motion *::before,
  .reduced-motion *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

