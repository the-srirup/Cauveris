"use client";

import type { ReactNode } from "react";
import { Button } from "./Button";

export interface EmptyStateProps {
  /** Main icon */
  icon?: ReactNode;
  /** Title text */
  title: string;
  /** Description text */
  description?: string;
  /** Primary action */
  action?: ReactNode;
  /** Secondary action */
  secondaryAction?: ReactNode;
  /** Size variant */
  size?: "sm" | "md" | "lg";
  /** Alignment */
  align?: "center" | "left";
  /** Additional class names */
  className?: string;
}

const sizeStyles = {
  sm: "py-6 px-4",
  md: "py-10 px-6",
  lg: "py-16 px-8",
};

const iconSizes = {
  sm: "h-10 w-10",
  md: "h-14 w-14",
  lg: "h-20 w-20",
};

const titleSizes = {
  sm: "text-base",
  md: "text-lg",
  lg: "text-xl",
};

const descSizes = {
  sm: "text-sm",
  md: "text-base",
  lg: "text-lg",
};

export function EmptyState({
  icon,
  title,
  description,
  action,
  secondaryAction,
  size = "md",
  align = "center",
  className = "",
}: EmptyStateProps) {
  const alignClasses = {
    center: "text-center mx-auto",
    left: "text-left",
  };

  return (
    <div className={`empty-state flex flex-col items-center ${alignClasses[align]} ${sizeStyles[size]} ${className}`} role="status" aria-live="polite">
      {icon && (
        <div className={`flex-shrink-0 text-[var(--color-fg-subtle)] opacity-50 ${iconSizes[size]}`} aria-hidden="true">
          {icon}
        </div>
      )}
      <div className="mt-4 max-w-md">
        <h3 className={`font-semibold text-[var(--color-fg-default)] ${titleSizes[size]}`}>{title}</h3>
        {description && (
          <p className={`mt-2 text-[var(--color-fg-muted)] ${descSizes[size]}`}>{description}</p>
        )}
      </div>
      {(action || secondaryAction) && (
        <div className="mt-6 flex items-center justify-center gap-3 flex-wrap">
          {secondaryAction && (
            <Button variant="ghost" size="md">
              {secondaryAction}
            </Button>
          )}
          {action && <Button variant="primary" size="md">{action}</Button>}
        </div>
      )}
    </div>
  );
}

