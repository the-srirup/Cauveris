                                aria-label={`Delete report ${report.title}`}
                                title={`Delete report ${report.title}`}
                              >
                                <Trash2 className="h-4 w-4" />
                              </button>
                            </Tooltip>
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </PanelSection>
      </Panel>

