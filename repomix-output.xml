            "remaining": max(0, settings.max_anonymous_incidents - _anonymous_incident_count),
        }
        if is_anonymous
        else None,
        "user_limits": {
            "active_incidents": {
                "limit": settings.max_active_incidents_per_user,
                "used": _active_incidents_per_user[user_id],
                "remaining": max(
