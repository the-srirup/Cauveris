def validate_reconstruction(
    incident: SyntheticIncident,
    reconstruction: HolographicReconstruction,
    tolerance: float = 0.2,
) -> Dict[str, Any]:
    """
    Validate a reconstruction against ground truth.

    Returns:
        Dict with fidelity scores, root cause accuracy, per-component errors.
    """
    gt = incident.ground_truth
    results = {
        "incident_id": incident.incident_id,
        "incident_type": gt.incident_type.value,
        "root_cause_correct": False,
        "root_cause_dimension_correct": False,
        "per_component_fidelity": {},
        "overall_fidelity": 0.0,
        "detailed_errors": {},
    }

    # Check root cause identification
    recon_root = ""
    recon_dim = ""
    max_pressure = 0.0
    for svc, sstate in reconstruction.reconstructed_services.items():
        # ReconstructedServiceState is a slots dataclass (no __dict__) — only
        # the normalized pressure dimensions are root-cause candidates.
        for dim in PRESSURE_DIMENSIONS:
            val = getattr(sstate, dim)
            if val > max_pressure:
                max_pressure = val
                recon_root = f"{svc}/{dim}"
                recon_dim = dim

    # Compare in the reconstruction's vocabulary (gt uses generator dim names
    # like "cpu_pressure"; the recon state uses normalized names like
    # "cpu_usage"). Dimensions the recon side cannot express can never match
    # a pressure dim, so for those the component match alone decides
    # root_cause_correct and the dimension is scored as incorrect.
    gt_dim_mapped = GT_DIMENSION_TO_RECON.get(gt.root_cause_dimension)
    results["root_cause_dimension_correct"] = (
        recon_dim != "" and gt_dim_mapped is not None and recon_dim == gt_dim_mapped
    )
    results["root_cause_correct"] = (
        recon_root != ""
        and recon_root.split("/", 1)[0] == gt.root_cause
        and (gt_dim_mapped is None or results["root_cause_dimension_correct"])
    )
    results["reconstructed_root_cause"] = recon_root
    results["expected_root_cause"] = f"{gt.root_cause}/{gt.root_cause_dimension}"

    # Per-component fidelity (cosine similarity of state vectors)
    total_similarity = 0
    count = 0

    for comp, gt_state in gt.component_states.items():
        if comp not in reconstruction.reconstructed_services:
            results["per_component_fidelity"][comp] = 0.0
            continue

        recon_state = reconstruction.reconstructed_services[comp]

        # Build state vectors in the SAME vocabulary: translate gt dim names to
        # recon field names and skip gt dims the recon state cannot express
        # (previously each unmapped name read getattr(..., 0), so the recon
        # vector was all zeros and every cosine collapsed to 0.0).
        pairs = sorted(
            (gt_dim, GT_DIMENSION_TO_RECON[gt_dim])
            for gt_dim in gt_state
            if gt_dim in GT_DIMENSION_TO_RECON
        )
        if not pairs:
            # No comparable dimension — record 0.0 but keep it out of the mean.
            results["per_component_fidelity"][comp] = 0.0
            continue

        gt_vec = np.array([gt_state[gt_dim] for gt_dim, _ in pairs])
        recon_vec = np.array([getattr(recon_state, recon_dim) for _, recon_dim in pairs])

        # Cosine similarity
        norm_gt = np.linalg.norm(gt_vec)
        norm_recon = np.linalg.norm(recon_vec)
        if norm_gt > 0 and norm_recon > 0:
            sim = np.dot(gt_vec, recon_vec) / (norm_gt * norm_recon)
        else:
            sim = 0.0

        results["per_component_fidelity"][comp] = float(sim)
        total_similarity += sim
        count += 1

    # Network fidelity
    for (src, dst), gt_net in gt.network_states.items():
        if src in reconstruction.network_edges and dst in reconstruction.network_edges:
            edge = next(
                (
                    e
                    for e in reconstruction.network_edges.values()
                    if e.source == src and e.target == dst
                ),
                None,
            )
            if edge:
                gt_lat = gt_net.get("latency", 0)
                gt_loss = gt_net.get("loss", 0)
                recon_lat = edge.latency
                recon_loss = edge.packet_loss

                lat_sim = 1 - min(abs(gt_lat - recon_lat) / max(gt_lat, 1), 1)
                loss_sim = 1 - min(abs(gt_loss - recon_loss), 1)
                net_sim = (lat_sim + loss_sim) / 2

                results["per_component_fidelity"][f"net_{src}_{dst}"] = float(net_sim)
                total_similarity += net_sim
                count += 1

    results["overall_fidelity"] = total_similarity / count if count > 0 else 0.0

    return results


if __name__ == "__main__":
    # Demo: Generate all incident types
    incidents = generate_all_incident_types()
    print(f"Generated {len(incidents)} synthetic incidents:")
    for inc in incidents:
        print(f"  {inc.incident_id}: {inc.ground_truth.incident_type.value}")
        print(
            f"    Root cause: {inc.ground_truth.root_cause}/{inc.ground_truth.root_cause_dimension}"
        )
        print(f"    HEUs: {len(inc.heus)}")
        print(f"    Components: {list(inc.ground_truth.component_states.keys())}")
